<Window x:Class="StarCitizenJapaneseTextCreater.HangarSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="My Hangar 同期" Width="1000" Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作バー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="同期開始" x:Name="btnSync" Click="Sync_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="12,6"/>
            <Button Content="中止" x:Name="btnCancel" Click="Cancel_Click" IsEnabled="False"
                    Padding="12,6" Margin="8,0,0,0"/>
            <Button Content="ログイン完了 → 再試行" x:Name="btnLoginDone" Click="LoginDone_Click"
                    Visibility="Collapsed" Background="#1976D2" Foreground="White" FontWeight="Bold"
                    Padding="12,6" Margin="8,0,0,0"/>
            <CheckBox Content="ログイン状態を保持する" x:Name="chkKeepLogin"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock Text="Cookie は WorkDir 内に平文で保存されます"
                       Foreground="#888" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
        </StackPanel>

        <!-- ブラウザ -->
        <wv2:WebView2 Grid.Row="1" x:Name="webView"/>

        <!-- ログ -->
        <TextBox Grid.Row="2" x:Name="txtLog" Height="120" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11"
                 Background="#1E1E1E" Foreground="#DDD"/>
    </Grid>
</Window>
