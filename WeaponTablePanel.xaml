<UserControl x:Class="StarCitizenJapaneseTextCreater.WeaponTablePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater">
    <!-- 武器の表 (［船舶戦闘］［個人戦闘］タブ)。武器をすべて 1 つの表に出し、絞り込み・並べ替えは表の部品 (FilterSortGrid) で行う -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage" Grid.Row="0" Foreground="#666" Margin="0,0,0,6" Visibility="Collapsed"/>

        <local:FilterSortGrid x:Name="table" Grid.Row="1"/>

        <!-- 最大 DPS の注 (注1 / 注2 の印がある行を表に出しているときだけ) -->
        <TextBlock x:Name="txtNotes" Grid.Row="2" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</UserControl>
