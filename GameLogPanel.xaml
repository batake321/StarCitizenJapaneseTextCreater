<UserControl x:Class="StarCitizenJapaneseTextCreater.GameLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater">
    <!-- ゲームのログ (［ゲームログ］タブ)。Game.log と logbackups の過去のログから、死亡・衝突・契約・買い物・取引・量子ジャンプ・区域・船の呼び出し・格納・採掘 (手掘り) を拾って 1 つの表に出す -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状態 (読み込み中のファイル数・件数、Game.log が見つからないときの案内) -->
        <TextBlock x:Name="txtMessage" Grid.Row="0" Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap"/>

        <local:FilterSortGrid x:Name="table" Grid.Row="1"/>
    </Grid>
</UserControl>
