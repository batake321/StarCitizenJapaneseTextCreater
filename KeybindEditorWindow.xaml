<Window x:Class="StarCitizenJapaneseTextCreater.KeybindEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater"
        Title="キーバインド エディタ" Height="780" Width="1200"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="GamepadBadge" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#42A5F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="ModifiedBadge" TargetType="Border">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="tabMain" SelectionChanged="TabMain_Changed">
            <!-- 機能別タブ (existing functionality) -->
            <TabItem Header="  機能別  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtSearch" Width="200" VerticalAlignment="Center" Margin="0,0,8,0"
                                     TextChanged="Search_Changed"/>
                            <ComboBox x:Name="cmbCategory" Width="220" VerticalAlignment="Center" Margin="0,0,8,0"
                                      SelectionChanged="Category_Changed"/>
                            <ComboBox x:Name="cmbInputFilter" Width="130" VerticalAlignment="Center" Margin="0,0,8,0"
                                      SelectionChanged="InputFilter_Changed">
                                <ComboBoxItem Content="全入力" IsSelected="True"/>
                                <ComboBoxItem Content="キーボード"/>
                                <ComboBoxItem Content="マウス"/>
                                <ComboBoxItem Content="ゲームパッド"/>
                                <ComboBoxItem Content="HOTAS"/>
                                <ComboBoxItem Content="未割当のみ"/>
                                <ComboBoxItem Content="変更済みのみ"/>
                            </ComboBox>
                            <Button Content="印刷" Click="Print_Click" Padding="12,4" Margin="0,0,4,0"/>
                            <Button Content="エクスポート" Click="Export_Click" Padding="12,4" Margin="0,0,4,0"/>
                            <Button Content="インポート" Click="Import_Click" Padding="12,4"/>
                        </WrapPanel>
                    </Border>

                    <!-- Main content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category tree -->
                        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="カテゴリ" FontWeight="Bold" Padding="8,6" Background="#FAFAFA"/>
                                <ListBox x:Name="lstCategories" Grid.Row="1" BorderThickness="0"
                                         SelectionChanged="CategoryList_Changed">
                                    <ListBox.ItemContainerStyle>
                                        <!-- 水色は項目の中の Border で塗る (契約タブのカテゴリ一覧と同じ作り。ListBoxItem の Background は選択中・マウスが乗ったとき既定の色で上書きされるため)。
                                             余白は既定の ListBoxItem の Padding (4,1) を Border に移して見た目を揃える -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 右の表で選んだ機能のカテゴリは水色 (選択中の項目でも水色) -->
                                            <Border Padding="4,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter Property="Background" Value="#B3E5FC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActionCount}" Foreground="#888" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Action list -->
                        <DataGrid x:Name="dgActions" Grid.Column="1" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  AlternationCount="2" FontSize="13"
                                  MouseDoubleClick="DgActions_DoubleClick"
                                  SelectionChanged="DgActions_SelectionChanged"
                                  RowHeight="32">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <!-- スティック・ゲームパッドで押した入力が割り当ててある行 (HOTAS タブの押した行の強調と同じオレンジの枠) -->
                                        <DataTrigger Binding="{Binding IsPressHighlighted}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF6F00"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="機能" Binding="{Binding DisplayName}" Width="200"
                                                    SortMemberPath="ActionName">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="キーボード" Binding="{Binding KeyboardDisplayJa}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardModified}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="マウス" Binding="{Binding MouseDisplayJa}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseModified}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ゲームパッド" Binding="{Binding GamepadDisplayJa}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="#90CAF9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGamepadModified}" Value="True">
                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="HOTAS" Binding="{Binding HotasDisplay}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHotasModified}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="カテゴリ" Binding="{Binding CategoryDisplayName}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#888"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- キーボードタブ -->
            <TabItem Header="  キーボード  ">
                <local:KeyboardLayoutPanel x:Name="keyboardPanel"/>
            </TabItem>

            <!-- マウスタブ -->
            <TabItem Header="  マウス  ">
                <local:MouseLayoutPanel x:Name="mousePanel"/>
            </TabItem>

            <!-- コントローラータブ -->
            <TabItem Header="  コントローラー  ">
                <local:GamepadLayoutPanel x:Name="gamepadPanel"/>
            </TabItem>

            <!-- HOTAS タブ -->
            <TabItem Header="  HOTAS  ">
                <local:HotasLayoutPanel x:Name="hotasPanel"/>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Foreground="#666"/>
                    <!-- ［機能別］タブで、js 番号を判別できない機器 (と手で選んだ機器) を押したときだけ出す: 「この機器は js◯」を選ぶ -->
                    <StackPanel x:Name="pnlFuncJsChoice" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="この機器は:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="btnFuncJs1" Content="js1" Click="FuncJs1_Click" Padding="8,1" Margin="0,0,4,0"/>
                        <Button x:Name="btnFuncJs2" Content="js2" Click="FuncJs2_Click" Padding="8,1"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存" Click="SaveApply_Click" Padding="16,4" Margin="0,0,4,0"
                            FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                    <Button Content="閉じる" Click="Close_Click" Padding="16,4" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
