<Window x:Class="StarCitizenJapaneseTextCreater.ImportSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インポート選択" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="インポートするデータを選択してください" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock x:Name="txtFileInfo" Grid.Row="1" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12"/>

        <!-- カテゴリ選択 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <CheckBox x:Name="chkTranslations" Margin="0,6" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="翻訳データ" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTransCount" Foreground="#666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkGlossary" Margin="0,6" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="用語集" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGlossaryCount" Foreground="#666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkIndex" Margin="0,6" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ゲームデータインデックス" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtIndexCount" Foreground="#666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkKnowledge" Margin="0,6" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="記憶データ" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtKnowledgeCount" Foreground="#666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="chkTrade" Margin="0,6" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="交易データ (価格・在庫)" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTradeCount" Foreground="#666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkAll" Content="すべて選択" FontSize="13" Margin="0,6"
                      Checked="ChkAll_Changed" Unchecked="ChkAll_Changed"/>
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,4,0,8"/>

        <!-- 取り込み方 (選ぶものは無い。決まりの説明だけ) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="取り込み方" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="ゲームやネットから取得したデータは、バックアップの内容に置き換えます。自分で登録したもの (手動の訳・用語集・記憶・所持船など) は今のものを残し、バックアップにだけあるものを足します。"
                       Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="インポート" Click="Import_Click" Padding="20,8" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Click="Cancel_Click" Padding="20,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
