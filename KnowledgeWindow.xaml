<Window x:Class="StarCitizenJapaneseTextCreater.KnowledgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="記憶管理" Width="800" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="選択を Discord にコピー" Click="CopyToDiscord_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="全選択" Click="SelectAll_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="選択解除" Click="DeselectAll_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="選択を削除" Click="DeleteSelected_Click" Padding="12,4" Margin="0,0,8,0"
                    Foreground="#C00"/>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="フィルタ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbFilter" Width="120" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="すべて" IsSelected="True" Tag=""/>
                    <ComboBoxItem Content="バグ" Tag="bug"/>
                    <ComboBoxItem Content="用語" Tag="term"/>
                    <ComboBoxItem Content="Tips" Tag="tip"/>
                    <ComboBoxItem Content="一般" Tag="general"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Knowledge list -->
        <DataGrid Grid.Row="1" x:Name="dgKnowledge" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="" Width="30"/>
                <DataGridTextColumn Binding="{Binding CreatedAtStr}" Header="日時" Width="140"/>
                <DataGridTextColumn Binding="{Binding CategoryDisplay}" Header="分類" Width="60"/>
                <DataGridTextColumn Binding="{Binding Content}" Header="内容" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Import area -->
        <Expander Grid.Row="2" Header="Discord から取り込み (テキスト貼り付け)" Margin="0,8,0,0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="1行1件。先頭の「- 」「・」「* 」は自動除去。[bug] [tip] 等のタグがあればカテゴリ設定。"
                           Foreground="#666" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="txtImport" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="既定カテゴリ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cmbImportCategory" Width="100" Margin="0,0,8,0">
                        <ComboBoxItem Content="general" IsSelected="True"/>
                        <ComboBoxItem Content="bug"/>
                        <ComboBoxItem Content="term"/>
                        <ComboBoxItem Content="tip"/>
                    </ComboBox>
                    <Button x:Name="btnImport" Content="取り込み" Click="Import_Click" Padding="16,4" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" x:Name="txtStatus" Foreground="#666" FontSize="11" Margin="0,6,0,0"/>
    </Grid>
</Window>
