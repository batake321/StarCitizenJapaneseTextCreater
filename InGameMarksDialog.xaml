<Window x:Class="StarCitizenJapaneseTextCreater.InGameMarksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日本語化" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="ゲーム内で名前に以下を付けたい時は" FontSize="14"/>
        <TextBlock Text="下のオプションにチェックを付けてください" FontSize="14" Margin="0,0,0,12"/>

        <CheckBox x:Name="chkEquipClassMarks" Margin="0,4">
            <TextBlock Text="装備名の後ろに分類を付ける　例：Bracer [軍1C]"/>
        </CheckBox>
        <CheckBox x:Name="chkMissionRepMarks" Margin="0,4">
            <TextBlock Text="ミッション名に派閥と貢献度を付ける　例：トラッカーライセンス認定資格 [バウンティーハンターズ・ギルド +50]"/>
        </CheckBox>
        <CheckBox x:Name="chkBlueprintMarks" Margin="0,4">
            <TextBlock Text="ミッション名に設計図を付ける　例：Orison救援：小規模製造依頼 [BP]"/>
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="実行" IsDefault="True" Click="Ok_Click" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="キャンセル" IsCancel="True" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
