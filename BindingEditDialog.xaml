<Window x:Class="StarCitizenJapaneseTextCreater.BindingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バインディング編集" Height="700" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Action info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="txtActionName" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="txtCategory" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Current bindings -->
        <GroupBox Grid.Row="1" Header="現在のバインド" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="キーボード:" Grid.Row="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                <TextBox x:Name="txtKeyboard" Tag="keyboard" GotKeyboardFocus="Field_GotKeyboardFocus" Cursor="Hand" ToolTip="クリックして選ぶ (赤い枠が付きます。下の「入力を選択」がこの機器に切り替わり、［クリア］でこの欄の割り当てを消せます)" Grid.Row="0" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                         Background="#F8F8F8" FontFamily="Consolas"/>
                <Button Content="設定" Grid.Row="0" Grid.Column="2" Margin="4,4,0,4" Click="SetKeyboard_Click"/>

                <TextBlock Text="マウス:" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                <TextBox x:Name="txtMouse" Tag="mouse" GotKeyboardFocus="Field_GotKeyboardFocus" Cursor="Hand" ToolTip="クリックして選ぶ (赤い枠が付きます。下の「入力を選択」がこの機器に切り替わり、［クリア］でこの欄の割り当てを消せます)" Grid.Row="1" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                         Background="#F8F8F8" FontFamily="Consolas"/>
                <Button Content="設定" Grid.Row="1" Grid.Column="2" Margin="4,4,0,4" Click="SetMouse_Click"/>

                <TextBlock Text="ゲームパッド:" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                <TextBox x:Name="txtGamepad" Tag="gamepad" GotKeyboardFocus="Field_GotKeyboardFocus" Cursor="Hand" ToolTip="クリックして選ぶ (赤い枠が付きます。下の「入力を選択」がこの機器に切り替わり、［クリア］でこの欄の割り当てを消せます)" Grid.Row="2" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                         Background="#E3F2FD" FontFamily="Consolas"/>
                <Button Content="設定" Grid.Row="2" Grid.Column="2" Margin="4,4,0,4" Click="SetGamepad_Click"/>

                <TextBlock x:Name="lblJoystick1" Text="HOTAS R:" Grid.Row="3" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                <TextBox x:Name="txtJoystickR" Tag="joystick1" GotKeyboardFocus="Field_GotKeyboardFocus" Cursor="Hand" ToolTip="クリックして選ぶ (赤い枠が付きます。下の「入力を選択」がこの機器に切り替わり、［クリア］でこの欄の割り当てを消せます)" Grid.Row="3" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                         Background="#FFF3E0" FontFamily="Consolas"/>
                <Button Content="設定" Grid.Row="3" Grid.Column="2" Margin="4,4,0,4" Click="SetJoystickR_Click"/>

                <TextBlock x:Name="lblJoystick2" Text="HOTAS L:" Grid.Row="4" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                <TextBox x:Name="txtJoystickL" Tag="joystick2" GotKeyboardFocus="Field_GotKeyboardFocus" Cursor="Hand" ToolTip="クリックして選ぶ (赤い枠が付きます。下の「入力を選択」がこの機器に切り替わり、［クリア］でこの欄の割り当てを消せます)" Grid.Row="4" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                         Background="#FFF3E0" FontFamily="Consolas"/>
                <Button Content="設定" Grid.Row="4" Grid.Column="2" Margin="4,4,0,4" Click="SetJoystickL_Click"/>

                <CheckBox x:Name="chkLongPress" Grid.Row="5" Grid.ColumnSpan="3" Content="長押し (Hold)" Margin="0,8,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Input selector -->
        <GroupBox Grid.Row="2" Header="入力を選択 (修飾キー + 入力の組み合わせ)" x:Name="grpSelector">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Modifiers -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="修飾キー:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                    <CheckBox x:Name="chkLShift" Content="左Shift" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkRShift" Content="右Shift" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkLCtrl" Content="左Ctrl" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkRCtrl" Content="右Ctrl" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkLAlt" Content="左Alt" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkRAlt" Content="右Alt" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkGpLB" Content="LB" Margin="0,0,8,0" VerticalAlignment="Center"
                              Foreground="#1565C0" FontWeight="Bold"/>
                    <CheckBox x:Name="chkGpRB" Content="RB" Margin="0,0,8,0" VerticalAlignment="Center"
                              Foreground="#1565C0" FontWeight="Bold"/>
                </WrapPanel>

                <!-- Key list -->
                <ListBox x:Name="lstKeys" Grid.Row="1" SelectionChanged="Key_Selected">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1"
                                    CornerRadius="4" Padding="8,4" Margin="2">
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="txtSelectedInput" Grid.Row="2" Margin="0,4,0,0" FontFamily="Consolas"
                           Foreground="#333" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <!-- 物理コントローラー / HOTAS を押したときの確認欄 -->
        <Border x:Name="pnlPressConfirm" Grid.Row="3" Visibility="Collapsed" Margin="0,8,0,0" Padding="8"
                Background="#FFFDE7" BorderBrush="#FBC02D" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtPressInput" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtPressCurrent" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <!-- js 番号を判別できない機器 (と手で選んだ機器) のときだけ出す: 「この機器は js◯」を選ぶ -->
                    <WrapPanel x:Name="pnlPressJsChoice" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Text="この機器は:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="btnPressJs1" Content="js1" Click="PressJs1_Click" Padding="8,2" Margin="0,0,4,0"/>
                        <Button x:Name="btnPressJs2" Content="js2" Click="PressJs2_Click" Padding="8,2"/>
                    </WrapPanel>
                    <!-- この入力を使っている他の機能: 1 機能 1 行。各行の右に［変更］［削除］(予定があれば［取消］) -->
                    <TextBlock x:Name="txtPressOthers" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlPressOthers"/>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                    <Button x:Name="btnPressApply" Content="反映" Click="PressApply_Click" Padding="16,4" Margin="0,0,0,4"/>
                    <Button Content="キャンセル" Click="PressCancel_Click" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="割り当てを削除するときは、消したい機器の欄をクリックして選び（赤い枠が付きます）、［クリア］を押してください。"
                       TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"/>
            <!-- ほかの機能の［変更］［削除］の予定 (［OK］で確定、［キャンセル］で取り消し) -->
            <TextBlock x:Name="txtOtherPlans" TextWrapping="Wrap" Foreground="#D84315" Margin="0,0,0,6" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="デフォルトに戻す" Click="ResetDefault_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="btnClear" Content="クリア" Click="Clear_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="選んでいる欄 (赤い枠) の割り当てを消します。消したい機器の欄をクリックして選んでから押してください。"/>
                <Button Content="OK" Click="Ok_Click" Padding="20,6" FontWeight="Bold" IsDefault="True"/>
                <Button Content="キャンセル" Click="Cancel_Click" Padding="12,6" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
