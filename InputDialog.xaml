<Window x:Class="StarCitizenJapaneseTextCreater.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" SizeToContent="WidthAndHeight" MinWidth="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="txtMessage" Text="入力してください:" Margin="0,0,0,8"/>
        <TextBox x:Name="txtInput" Width="300" Margin="0,0,0,12"
                 KeyDown="TxtInput_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="キャンセル" Width="80" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
