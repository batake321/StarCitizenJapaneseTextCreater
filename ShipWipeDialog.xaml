<Window x:Class="StarCitizenJapaneseTextCreater.ShipWipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ワイプ — 削除する船を選ぶ" Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ワイプで無くなる船を選んで、まとめて削除します"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12"
                   Text="ゲーム内 (aUEC) で買った船は既定でチェックが入っています。Wikelo の報酬など、ワイプ後も残る船はチェックを外してください。pledge (実際に購入した船) はワイプで消えないため、既定ではチェックが入りません。"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="すべて選択" Click="SelectAll_Click" Padding="12,4" Margin="0,0,4,0"/>
            <Button Content="すべて解除" Click="SelectNone_Click" Padding="12,4" Margin="0,0,4,0"/>
            <Button Content="ゲーム内購入のみ選択" Click="SelectInGame_Click" Padding="12,4" Margin="0,0,4,0"/>
        </StackPanel>

        <DataGrid x:Name="dgWipeShips" Grid.Row="3"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA" RowHeight="28" FontSize="12"
                  CellEditEnding="Cell_EditEnding">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPledge}" Value="True">
                            <Setter Property="Foreground" Value="#1565C0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="削除" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="船名" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="由来" Binding="{Binding OriginDisplay}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="保有数" Binding="{Binding HangarCountDisplay}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="txtWipeStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="選択した船を削除" Click="Ok_Click" Padding="20,8" Margin="0,0,8,0"
                        Foreground="White" Background="#D32F2F" FontWeight="Bold"/>
                <Button Content="キャンセル" IsCancel="True" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
