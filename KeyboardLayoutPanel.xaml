<UserControl x:Class="StarCitizenJapaneseTextCreater.KeyboardLayoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modifier checkboxes + legend -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="修飾キー:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <CheckBox x:Name="chkLShift" Content="L-Shift" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkRShift" Content="R-Shift" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkLCtrl" Content="L-Ctrl" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkRCtrl" Content="R-Ctrl" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkLAlt" Content="L-Alt" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkRAlt" Content="R-Alt" Margin="0,0,20,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <TextBlock x:Name="txtKeyInfo" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            </WrapPanel>
        </Border>

        <!-- Color legend -->
        <Border Grid.Row="1" Background="#FAFAFA" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="色分け:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" FontSize="11"/>
                <!-- tap/press -->
                <Border Background="#42A5F5" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="タップ/押下" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <!-- hold -->
                <Border Background="#AB47BC" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="長押し" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <!-- double_tap -->
                <Border Background="#26A69A" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="二度押し" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <!-- modifier active -->
                <Border Background="#FFB74D" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="修飾キー(選択中)" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <!-- unbound -->
                <Border Background="#F0F0F0" BorderBrush="#B4B4B4" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="未割当" Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#CCC"/>
                <TextBlock Text="tap=短押しで発動  press=押し続けている間有効  hold=一定時間押し続けて発動  double_tap=素早く二度押し"
                           VerticalAlignment="Center" Foreground="#888" FontSize="10.5"/>
            </WrapPanel>
        </Border>

        <!-- Keyboard canvas -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
            <Canvas x:Name="canvas" Width="1220" Height="330" Background="White"/>
        </ScrollViewer>
    </Grid>
</UserControl>
