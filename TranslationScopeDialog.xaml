<Window x:Class="StarCitizenJapaneseTextCreater.TranslationScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日本語化の適応範囲" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="ゲームの文のうち、日本語にする範囲を選んでください" FontSize="14" Margin="0,0,0,12"/>

        <RadioButton x:Name="rbAll" GroupName="scope" Content="全て翻訳" Margin="0,4" Checked="Scope_Changed"/>
        <RadioButton x:Name="rbPartial" GroupName="scope" Content="一部翻訳" Margin="0,4" Checked="Scope_Changed"/>

        <!-- 種類のチェックボックス (TranslationScope.Categories の並び) はコードで足す -->
        <StackPanel x:Name="panelCategories" Margin="20,4,0,0">
            <TextBlock Text="チェックを付けた種類を日本語にします（外した種類は英語のまま）" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="次へ" IsDefault="True" Click="Ok_Click" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="キャンセル" IsCancel="True" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
