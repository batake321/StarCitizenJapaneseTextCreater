<Window x:Class="StarCitizenJapaneseTextCreater.Station3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ステーションの 3D 表示" Width="1200" Height="860"
        WindowStartupLocation="CenterOwner">
    <!-- ステーションの 3D 表示の別ウィンドウ (モードレス。［詳細］の［別ウィンドウ］から開く)。中身は Station3DWeb のビューア。
         上に場所の名前・［読み込み］・［内部のマップ］・状態。書き出していなければ自動で書き出さず［読み込み］で書き出す (船の Ship3DWindow と同じ)。
         ほかの場所への切り替えは無い (その場所の［詳細］の［別ウィンドウ］から開く) -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="txtPlace" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="btnImport" Content="読み込み" Padding="10,2" IsEnabled="False" Click="BtnImport_Click"
                    ToolTip="この場所の 3D をゲームデータ (選択中のチャンネルの Data.p4k) から書き出します。最新のものがあるとき・書き出し中は使えません"/>
            <Button x:Name="btnMap" Content="内部のマップ" Padding="10,2" Margin="6,0,0,0" Click="BtnMap_Click"
                    ToolTip="メインの画面の［マップ］タブに切り替えて、この場所の階層マップを出します (未取り込みなら［マップ］タブに［読み込み］を出します)"/>
            <TextBlock x:Name="txtState" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="#1B1E24">
            <Grid>
                <wv2:WebView2 x:Name="web3D" Visibility="Collapsed"/>
                <TextBlock x:Name="txtOverlay" Foreground="#DDD" FontSize="14" TextWrapping="Wrap" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="読み込み中..."/>
            </Grid>
        </Border>
    </Grid>
</Window>
