<UserControl x:Class="StarCitizenJapaneseTextCreater.OrePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater">
    <!-- ［鉱石］タブ: 上に採掘・積み荷の資源の在庫 (資源 × 品質 × 単位。trade_cache.db の ore_stock)、下に売買の記録 (commodity_trades) と採掘の記録 (mining_log)。
         在庫はログから自動で増減し (後半で接続)、手入力で追加・編集 (品質・量・メモ) ・削除できる -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- 上段: 在庫 -->
        <GroupBox Grid.Row="0" Header="在庫 (資源 × 品質)" Margin="0,0,0,4">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品質・量・メモは書き換えられる。OreStockRow の setter が OrePanel へ知らせ、確定の後に DB へ書き戻して読み直す (dgMyComponents と同じ流儀) -->
                <DataGrid x:Name="dgStock" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FAFAFA" FontSize="12" RowHeight="26" HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="資源" Binding="{Binding ResourceDisplay}" Width="240" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="グループ" Binding="{Binding GroupName}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="品質" Binding="{Binding QualityText}" Width="60" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="量" Binding="{Binding QuantityText}" Width="90" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="単位" Binding="{Binding Unit}" Width="50" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="メモ" Binding="{Binding Notes}" Width="*" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="ToolTip" Value="{Binding Notes}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="更新日時" Binding="{Binding UpdatedAt}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/><Setter Property="FontSize" Value="11"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 追加パネル: グループで絞る → 資源 (名前で検索) ・品質・量・単位・メモ -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="グループ:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cmbGroup" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" SelectionChanged="Group_Changed"/>
                    <TextBlock Text="検索:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtResourceSearch" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center"
                             TextChanged="ResourceSearch_TextChanged" ToolTip="日本語名 / 英語名 / レコード名の一部で絞り込み"/>
                    <TextBlock Text="資源:" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cmbResource" Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Center" DisplayMemberPath="Display" MinWidth="160">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <TextBlock Text="品質:" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtQuality" Grid.Column="7" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="0〜1000 の整数。空欄は不明"/>
                    <TextBlock Text="量:" Grid.Column="8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtQuantity" Grid.Column="9" Text="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="単位:" Grid.Column="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cmbUnit" Grid.Column="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="メモ:" Grid.Column="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtNotes" Grid.Column="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Content="追加" Grid.Column="14" Click="AddStock_Click" Padding="16,4"
                            FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="選択を削除" Click="DeleteStock_Click" Padding="12,4" Margin="0,0,8,0" Foreground="#D32F2F"/>
                    <Button Content="利益を再計算" Click="Recompute_Click" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="売買の記録の利益 (買いを先入れ先出しで売りに当てる) を計算し直し、まだ在庫に入れていない記録を在庫へ反映する"/>
                    <TextBlock x:Name="txtOreStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDD"/>

        <!-- 下段: 売買の記録・採掘の記録 (読み取り専用。FilterSortGrid) -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="160"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="売買の記録">
                <local:FilterSortGrid x:Name="tblTrades" Margin="4"/>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDD"/>
            <GroupBox Grid.Column="2" Header="採掘の記録">
                <local:FilterSortGrid x:Name="tblMining" Margin="4"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
