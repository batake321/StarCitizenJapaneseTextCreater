<UserControl x:Class="StarCitizenJapaneseTextCreater.GamepadLayoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="修飾ボタン:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <CheckBox x:Name="chkLB" Content="LB" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="Bold"
                          Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkRB" Content="RB" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="Bold"
                          Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <TextBlock x:Name="txtInfo" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="#FAFAFA" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="色分け:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" FontSize="11"/>
                <Border Background="#42A5F5" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="バインド済み" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#FFB74D" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="修飾ボタン(選択中)" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#F0F0F0" BorderBrush="#B4B4B4" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="未割当" Foreground="#555" FontSize="11"/>
                </Border>
                <TextBlock Text="  |  ボタンをクリックして割り当て編集" VerticalAlignment="Center" Foreground="#888" FontSize="10.5"/>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
            <Canvas x:Name="canvas" Width="1100" Height="500" Background="White"/>
        </ScrollViewer>
    </Grid>
</UserControl>
