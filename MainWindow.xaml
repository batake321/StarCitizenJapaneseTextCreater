<Window x:Class="StarCitizenJapaneseTextCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater"
        Title="Star Citizen Japanese Text Creator" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GamePath:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtGamePath" Width="400" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbChannel" Width="80" VerticalAlignment="Center" Margin="0,0,4,0"
                          SelectionChanged="Channel_Changed"/>
                <Button Content="参照..." Click="BrowseGamePath_Click" Padding="10,4" Margin="0,0,16,0"/>
                <Button Content="AI 設定" Click="AiSettings_Click" Padding="14,4" FontWeight="Bold"
                        Background="#4A90D9" Foreground="White"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8,4,8,8">
            <!-- 翻訳タブ -->
            <TabItem Header="翻訳">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="btnExtract" Content="1. 抽出" Style="{StaticResource ActionButton}" Click="Extract_Click"/>
                        <Button x:Name="btnTranslate" Content="2. 翻訳" Style="{StaticResource ActionButton}" Click="Translate_Click"/>
                        <Button x:Name="btnApply" Content="3. 反映" Style="{StaticResource ActionButton}" Click="Apply_Click"/>
                        <Button x:Name="btnCancel" Content="中止" Padding="14,6" Margin="16,4,4,4"
                                Background="#D94A4A" Foreground="White" FontWeight="Bold"
                                Click="Cancel_Click" Visibility="Collapsed"/>
                    </WrapPanel>

                    <!-- Progress area -->
                    <Grid Grid.Row="1" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="progressBar" Height="22" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="txtProgressPct" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="8,0,0,0" MinWidth="60" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock x:Name="txtProgressDetail" Grid.Row="2" Margin="0,0,0,4"
                               FontFamily="Consolas" FontSize="12" Foreground="#444"/>

                    <TextBox x:Name="txtLog" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                             Background="#1E1E1E" Foreground="#DCDCDC" Padding="4"
                             TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="ログ保存" Click="SaveLog_Click" Padding="12,4"/>
                        <Button Content="ログクリア" Click="ClearLog_Click" Padding="12,4" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 翻訳エディタタブ -->
            <TabItem Header="翻訳エディタ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Width="300" VerticalAlignment="Center" Margin="0,0,4,0"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Content="検索" Click="Search_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <CheckBox x:Name="chkPartialMatch" Content="部分一致" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="PartialMatch_Changed" Unchecked="PartialMatch_Changed"/>
                        <ComboBox x:Name="cmbSearchField" Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="SearchField_Changed">
                            <ComboBoxItem Content="全フィールド" IsSelected="True"/>
                            <ComboBoxItem Content="Key"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbSourceFilter" Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="SourceFilter_Changed">
                            <ComboBoxItem Content="全て" IsSelected="True"/>
                            <ComboBoxItem Content="official"/>
                            <ComboBoxItem Content="ai"/>
                            <ComboBoxItem Content="manual"/>
                            <ComboBoxItem Content="csv"/>
                            <ComboBoxItem Content="glossary"/>
                            <ComboBoxItem Content="original"/>
                            <ComboBoxItem Content="untranslated"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbTranslatorFilter" Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="TranslatorFilter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="txtDbStats" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTranslations" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" RowEditEnding="DgTranslations_RowEditEnding"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8"
                              FontSize="13" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" IsReadOnly="True" SortMemberPath="Key"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="260" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" IsReadOnly="True" SortMemberPath="Source"/>
                            <DataGridTextColumn Header="Translator" Binding="{Binding Translator}" Width="140" IsReadOnly="True" SortMemberPath="Translator"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="130" IsReadOnly="True" SortMemberPath="ModifiedAt"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="◀ 前" Click="PrevPage_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="次 ▶" Click="NextPage_Click" Padding="10,4" Margin="0,0,12,0"/>
                        <CheckBox x:Name="chkSelectAll" Content="全選択" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="SelectAll_Click"/>
                        <Button Content="選択した翻訳を削除 (再翻訳用)" Click="DeleteSelected_Click"
                                Padding="10,4" Margin="0,0,12,0" Foreground="#C00"/>
                        <Button Content="全て原文" Click="SetOriginal_Click"
                                Padding="10,4" Margin="0,0,12,0" ToolTip="選択したレコードの日本語を英語原文のままにする"/>
                        <Button Content="CSV Export" Click="CsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="CsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- 用語集タブ -->
            <TabItem Header="用語集">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="英語→日本語の用語を登録すると、AI翻訳時にプロンプトに含まれます。「一括置換」で既存の翻訳済みテキストにも反映できます。"/>

                    <DataGrid x:Name="dgGlossary" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="350" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="350" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="English:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossEn" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Japanese:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossJa" Grid.Column="3" VerticalAlignment="Center"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="追加/更新" Click="GlossaryAdd_Click" Style="{StaticResource ActionButton}"/>
                        <CheckBox x:Name="chkGlossarySelectAll" Content="全選択" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="GlossarySelectAll_Click"/>
                        <Button Content="選択削除" Click="GlossaryDelete_Click" Style="{StaticResource ActionButton}" Foreground="#C00"/>
                        <Button Content="一括置換 (翻訳済みテキストに適用)" Click="GlossaryBulkReplace_Click"
                                Style="{StaticResource ActionButton}" FontWeight="Bold"/>
                        <Button Content="CSV Export" Click="GlossaryCsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="GlossaryCsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- プロファイルタブ -->
            <TabItem Header="プロファイル">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="キャラクターデザイン" Grid.Column="0" Margin="0,0,4,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCharSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyChar_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="削除" Click="DeleteChar_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCharSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="キーバインド/コントロール設定" Grid.Column="1" Margin="4,0,0,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCtrlSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyCtrl_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="詳細設定" Click="KeybindEditor_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4A90D9" Foreground="White"/>
                                <Button Content="削除" Click="DeleteCtrl_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCtrlSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="txtProfileLog" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Height="150"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- コモディティタブ -->
            <TabItem Header="コモディティ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 条件入力 -->
                    <GroupBox Grid.Row="0" Header="検索条件" Margin="0,0,0,4">
                        <Grid Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="船:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="0"/>
                            <ComboBox x:Name="cmbTradeShip" Grid.Row="0" Grid.Column="1" Margin="0,0,12,0"
                                      SelectionChanged="TradeShip_Changed"/>

                            <TextBlock Text="積載 (SCU):" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="2"/>
                            <TextBox x:Name="txtTradeScu" Grid.Row="0" Grid.Column="3" Margin="0,0,12,0"
                                     Text="100" VerticalAlignment="Center"/>

                            <TextBlock Text="予算 (aUEC):" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="4"/>
                            <TextBox x:Name="txtTradeBudget" Grid.Row="0" Grid.Column="5" Margin="0,0,12,0"
                                     Text="1000000" VerticalAlignment="Center" ToolTip="3M=300万, 500k=50万, 1.5m=150万"/>

                            <TextBlock Text="買い星系:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="6"/>
                            <ComboBox x:Name="cmbTradeBuySystem" Grid.Row="0" Grid.Column="7" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="全て" IsSelected="True"/>
                                <ComboBoxItem Content="Stanton"/>
                                <ComboBoxItem Content="Pyro"/>
                                <ComboBoxItem Content="Nyx"/>
                            </ComboBox>

                            <TextBlock Text="売り星系:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="8"/>
                            <ComboBox x:Name="cmbTradeSellSystem" Grid.Row="0" Grid.Column="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="全て" IsSelected="True"/>
                                <ComboBoxItem Content="Stanton"/>
                                <ComboBoxItem Content="Pyro"/>
                                <ComboBoxItem Content="Nyx"/>
                            </ComboBox>

                            <!-- コモディティフィルタ -->
                            <TextBlock Text="コモディティ:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="10"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="11" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="btnCommodityFilter" Content="コモディティ選択 (全て)" Click="CommodityFilter_Click"
                                        Padding="8,3" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkExcludeOutpost" Content="地上小規模拠点を除く" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkLoadingDockOnly" Content="外部積込対応のみ (Hull C等)"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkExcludeLowStock" Content="在庫不足ルートを除く"
                                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Content="ルート検索" Click="TradeSearch_Click" Padding="16,4" Margin="0,0,4,0"
                                        FontWeight="Bold" Background="#1976D2" Foreground="White"/>
                                <Button Content="価格更新" Click="TradeRefresh_Click" Padding="12,4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTradeStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="11"
                                       Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- 結果テーブル -->
                    <DataGrid x:Name="dgTradeRoutes" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA" FontSize="13" RowHeight="52"
                              MouseLeftButtonUp="TradeRoutes_CellClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowBuyStock}" Value="True">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="コモディティ" Binding="{Binding CommodityName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CS" Binding="{Binding ContainerScuDisplay}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#888"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="利益/SCU" Binding="{Binding ProfitDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfitPerScu, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"><Setter Property="Foreground" Value="#1565C0"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ProfitPerScu, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"><Setter Property="Foreground" Value="#D32F2F"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="買値" Binding="{Binding BuyPriceDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="購入場所" Binding="{Binding BuyDisplay}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="在庫(買)" Binding="{Binding BuyStockDisplay}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="売値" Binding="{Binding SellPriceDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="売却場所" Binding="{Binding SellDisplay}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="在庫(売)" Binding="{Binding SellStockDisplay}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="数量" Binding="{Binding ActualScuDisplay}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="総利益" Binding="{Binding TotalProfitDisplay}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalProfit, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"><Setter Property="Foreground" Value="#1565C0"/></DataTrigger>
                                            <DataTrigger Binding="{Binding TotalProfit, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"><Setter Property="Foreground" Value="#D32F2F"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ROI" Binding="{Binding RoiDisplay}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="" Binding="{Binding StockWarning}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#D32F2F"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ステータスバー -->
                    <!-- 詳細パネル -->
                    <GroupBox x:Name="grpTradeDetail" Grid.Row="3" Margin="0,4,0,0" MaxHeight="220"
                              Visibility="Collapsed">
                        <GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtDetailHeader" Text="詳細"/>
                                <Button Grid.Column="1" Content="✕" Click="CloseDetail_Click"
                                        Padding="4,0" FontSize="11" Cursor="Hand" Background="Transparent" BorderThickness="0"/>
                            </Grid>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox x:Name="grpDetailLeft" Header="購入場所 (安い順)" Grid.Column="0" Margin="0,0,4,0">
                                <DataGrid x:Name="dgDetailBuy" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          FontSize="12" RowHeight="24" HeadersVisibility="Column"
                                          SelectionChanged="DetailBuy_Selected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="場所/コモディティ" Binding="{Binding Location}" Width="*"/>
                                        <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="70"/>
                                        <DataGridTextColumn Header="在庫" Binding="{Binding Stock}" Width="55"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox x:Name="grpDetailRight" Header="売却場所 (高い順)" Grid.Column="1" Margin="4,0,0,0">
                                <DataGrid x:Name="dgDetailSell" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          FontSize="12" RowHeight="24" HeadersVisibility="Column"
                                          SelectionChanged="DetailSell_Selected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="場所/コモディティ" Binding="{Binding Location}" Width="*"/>
                                        <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="70"/>
                                        <DataGridTextColumn Header="在庫" Binding="{Binding Stock}" Width="55"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <TextBlock x:Name="txtTradeInfo" Grid.Row="4" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <!-- 船舶管理タブ -->
            <TabItem Header="船舶管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ヘッダー -->
                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#333">
                        所持している船を管理します。コモディティタブの船セレクタに反映されます。UEX船データから選択するか、手動で追加できます。
                    </TextBlock>

                    <!-- 所持船一覧 -->
                    <DataGrid x:Name="dgMyShips" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA" FontSize="13" RowHeight="30"
                              MouseDoubleClick="MyShip_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="船名" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="積載 (SCU)" Binding="{Binding Scu}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="メモ" Binding="{Binding Notes}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="追加日" Binding="{Binding AddedAt}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/><Setter Property="FontSize" Value="11"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- UEX船検索 + 追加 -->
                    <GroupBox Grid.Row="2" Header="船を追加" Margin="0,8,0,0">
                        <Grid Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: 検索 + 候補選択 -->
                            <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtShipSearch" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center"
                                     KeyDown="ShipSearch_KeyDown" ToolTip="船名を入力して検索 or Enter"/>
                            <Button Content="検索" Grid.Column="2" Click="ShipSearch_Click" Padding="8,3" Margin="0,0,8,0"/>
                            <TextBlock Text="候補:" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="cmbAddShip" Grid.Column="4" Grid.ColumnSpan="4" MinWidth="280"
                                      DisplayMemberPath="DisplayName" SelectionChanged="AddShip_Selected" Margin="0,0,8,0"/>

                            <!-- Row 1: 詳細入力 -->
                            <TextBlock Text="船名:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipName" Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="メーカー:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipMfr" Grid.Row="1" Grid.Column="4" Margin="0,4,8,0" VerticalAlignment="Center" MinWidth="120"/>
                            <TextBlock Text="SCU:" Grid.Row="1" Grid.Column="6" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipScu" Grid.Row="1" Grid.Column="7" Text="0" Margin="0,4,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="メモ:" Grid.Row="1" Grid.Column="8" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipNotes" Grid.Row="1" Grid.Column="9" Margin="0,4,8,0" VerticalAlignment="Center"/>
                            <Button Content="追加" Grid.Row="1" Grid.Column="10" Click="AddMyShip_Click" Padding="16,4" Margin="0,4,0,0"
                                    FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                        </Grid>
                    </GroupBox>

                    <!-- 操作ボタン -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="選択を更新" Click="UpdateMyShip_Click" Padding="12,4" Margin="0,0,4,0"/>
                        <Button Content="選択を削除" Click="DeleteMyShip_Click" Padding="12,4" Margin="0,0,8,0" Foreground="#D32F2F"/>
                        <TextBlock x:Name="txtMyShipStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 価格キャプチャタブ -->
            <TabItem Header="価格キャプチャ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- コントロールバー -->
                    <GroupBox Grid.Row="0" Header="キャプチャ設定" Margin="0,0,0,4">
                        <StackPanel Margin="8,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="手動キャプチャ (画面全体)" Click="ManualCapture_Click"
                                        Padding="12,4" Margin="0,0,8,0" Background="#1976D2" Foreground="White" FontWeight="Bold"/>
                                <Button Content="クリップボードから読取" Click="ClipboardCapture_Click"
                                        Padding="12,4" Margin="0,0,8,0"/>
                                <Button Content="ファイルから読取" Click="FileCapture_Click"
                                        Padding="12,4" Margin="0,0,16,0"/>
                                <CheckBox x:Name="chkHotkeyEnabled" Content="PrintScreenホットキー有効"
                                          VerticalAlignment="Center" IsChecked="True"
                                          Checked="HotkeyEnabled_Changed" Unchecked="HotkeyEnabled_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="txtCaptureStatus" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- メインコンテンツ: プレビュー + パース結果 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左: スクリーンショットプレビュー -->
                        <GroupBox Header="キャプチャ画像" Grid.Column="0" Margin="0,0,4,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="imgCapturePreview" Stretch="Uniform"/>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 右: パース結果 -->
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ターミナル情報 -->
                            <GroupBox Header="認識結果" Grid.Row="0" Margin="0,0,0,4">
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ターミナル:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="cmbCaptureTerminal" Grid.Column="1" IsEditable="True"
                                              DisplayMemberPath="Key" SelectedValuePath="Value"/>
                                    <TextBlock Text="モード:" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <ComboBox x:Name="cmbCaptureMode" Grid.Column="3">
                                        <ComboBoxItem Content="BUY" IsSelected="True"/>
                                        <ComboBoxItem Content="SELL"/>
                                    </ComboBox>
                                    <TextBlock Text="信頼度:" Grid.Column="4" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBlock x:Name="txtOcrConfidence" Grid.Column="5" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontWeight="Bold"/>
                                </Grid>
                            </GroupBox>

                            <!-- コモディティデータグリッド (編集可能) -->
                            <DataGrid x:Name="dgCapturedCommodities" Grid.Row="1"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="True" IsReadOnly="False"
                                      GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA"
                                      FontSize="13" RowHeight="30">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsMatched}" Width="30"/>
                                    <DataGridTextColumn Header="コモディティ" Binding="{Binding MatchedName}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="OCR原文" Binding="{Binding RawName}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="在庫(SCU)" Binding="{Binding Inventory}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="信頼度" Binding="{Binding MatchConfidence, StringFormat=P0}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- 下部: アクションボタン + ステータス -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSubmitUex" Content="UEXに送信" Click="SubmitUex_Click"
                                Padding="14,6" Margin="0,0,8,0" FontWeight="Bold" Background="#FF6F00" Foreground="White"/>
                        <CheckBox x:Name="chkCaptureScreenshot" Content="スクリーンショットも送信"
                                  Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="クリア" Grid.Column="2" Click="ClearCapture_Click" Padding="12,4" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtSubmitStatus" Grid.Column="4" VerticalAlignment="Center"
                                   Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtOcrTiming" Grid.Column="5" VerticalAlignment="Center"
                                   Foreground="#999" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ミッションタブ -->
            <TabItem Header="ミッション">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Category list -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="カテゴリ" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <Button Grid.Row="1" x:Name="btnLoadMissions" Content="ミッション読み込み"
                                Click="LoadMissions_Click" Padding="10,6" Margin="0,0,0,8"
                                FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                        <ListBox Grid.Row="2" x:Name="lstMissionCategories"
                                 SelectionChanged="MissionCategory_Changed"
                                 FontSize="13" Padding="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="4,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="3" x:Name="txtMissionStatus" Foreground="#666"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Right: Mission list + detail -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- Mission list -->
                        <DataGrid Grid.Row="0" x:Name="dgMissions" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionChanged="Mission_Selected"
                                  CanUserSortColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="名前" Width="320" SortMemberPath="CleanedName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2">
                                                <TextBlock Text="{Binding DisplayNameJa}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="Black" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DisplayNameJa, Converter={x:Static local:StringToVisConverter.Instance}}"/>
                                                <TextBlock Text="{Binding DisplayNameEn}" Foreground="#333" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="難易度" Binding="{Binding Difficulty}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="報酬 (aUEC)" Binding="{Binding DisplayReward}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="場所" Binding="{Binding Location}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="#DDD" Margin="0,2"/>

                        <!-- Mission detail -->
                        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txtMissionDetail" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="14"
                                           Foreground="#DCDCDC" Padding="8"
                                           Text="カテゴリを選択し、ミッションをクリックすると詳細が表示されます。"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- チャットタブ -->
            <TabItem Header="チャット">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: backend selector + data fetch toggle -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="AI バックエンド:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbChatBackend" Width="200" VerticalAlignment="Center" Margin="0,0,16,0"
                                  SelectionChanged="CmbChatBackend_SelectionChanged"/>
                        <CheckBox x:Name="chkFetchScData" Content="スキル使用 (API/DB検索)"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="履歴クリア" Click="ChatClear_Click" Padding="10,4" VerticalAlignment="Center"/>
                        <Button Content="全体コピー" Click="ChatCopyAll_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Content="記憶管理" Click="KnowledgeManage_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- External AI consultation + Verification agent (1 row) -->
                    <WrapPanel x:Name="pnlConsultBackends" Grid.Row="1" Margin="0,0,0,2">
                        <TextBlock Text="📡 外部AI相談:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#666"/>
                        <!-- checkboxes inserted dynamically -->
                        <!-- separator + verify agent appended dynamically -->
                    </WrapPanel>

                    <!-- Chat messages area -->
                    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" ClipToBounds="True">
                        <ScrollViewer x:Name="svChat" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icChatMessages">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,8" CornerRadius="8"
                                                Background="{Binding Background}"
                                                HorizontalAlignment="{Binding Alignment}">
                                            <Border.MaxWidth>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                         Converter="{x:Static local:ChatWidthConverter.Instance}"/>
                                            </Border.MaxWidth>
                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{x:Static local:ChatTemplateSelector.Instance}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Input area -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput" Grid.Column="0" AcceptsReturn="True"
                                 TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Padding="8,6"
                                 PreviewKeyDown="ChatInput_PreviewKeyDown"/>
                        <Button x:Name="btnChatSend" Grid.Column="1" Content="送信" Click="ChatSend_Click"
                                Padding="20,8" Margin="8,0,0,0" FontWeight="Bold"
                                Background="#4A90D9" Foreground="White" FontSize="13"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 設定タブ -->
            <TabItem Header="設定">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="基本設定" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="GamePath:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtSettingsGamePath" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Working Directory:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtWorkDir" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Output Language:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtOutputLang" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Star Citizen API (チャット用)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="SC API Key:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtScApiKey" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" Foreground="#666" TextWrapping="Wrap"
                                           Text="starcitizen-api.com の API キー。Discord で /api register コマンドで取得できます。"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="UEX 価格送信 (Screen Capture)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="UEX API Key:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtUexApiKey" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" Foreground="#666" TextWrapping="Wrap"
                                           Text="uexcorp.space のデータ送信用 API キー。My Apps ページでアプリを作成して取得できます。PrintScreenキーでゲーム画面をキャプチャし、OCRで価格を読み取ってUEXに送信します。"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="ゲームデータ連携 (Data.p4k)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"
                                           Text="StarBreaker CLI で Data.p4k からゲーム内データ（船・武器・コンポーネント・契約）を抽出しDBに格納します。インデックス構築（約2分半）でパッチ毎のデータをキャッシュし、FTS5 全文検索で日本語・あいまい検索が可能になります。ベクトル検索構築は「AI 設定」のバックエンド（Ollama優先）を使用し約2分15秒（合計約5分）。"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnExtractGameData" Content="インデックス構築"
                                            Click="ExtractGameData_Click" Padding="14,6"
                                            FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                    <Button x:Name="btnBuildVectorIndex" Content="ベクトル検索構築"
                                            Click="BuildVectorIndex_Click" Padding="14,6" Margin="8,0,0,0"
                                            FontWeight="Bold" Background="#9C27B0" Foreground="White"
                                            ToolTip="Ollama/OpenAI/Gemini のエンベディングモデルでセマンティック検索を有効化（バックグラウンド実行）"/>
                                    <TextBlock x:Name="txtGameDataStatus" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="#666"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="pbGameData" Height="20" Minimum="0" Maximum="100"/>
                                    <TextBlock x:Name="txtGameDataPct" Grid.Column="1" VerticalAlignment="Center"
                                               Margin="8,0,0,0" MinWidth="50" FontWeight="Bold"/>
                                </Grid>

                                <TextBlock x:Name="txtGameDataDetail" Grid.Row="3" Foreground="#444"
                                           FontFamily="Consolas" FontSize="12"/>

                                <TextBlock x:Name="txtSearchIndexStatus" Grid.Row="4" Margin="0,4,0,0" Foreground="#666"
                                           FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Web チャットサーバー" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="HTTP ポート:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <TextBox x:Name="txtWebPort" Width="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="HTTPS:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox x:Name="txtWebHttpsPort" Width="60" VerticalAlignment="Center"/>
                                    <Button x:Name="btnWebServer" Content="サーバー起動" Click="WebServer_Click"
                                            Padding="14,4" Margin="8,0,0,0" FontWeight="Bold"
                                            Background="#4A90D9" Foreground="White"/>
                                    <CheckBox x:Name="chkWebAutoStart" Content="自動起動" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="VoiceVox URL:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxUrl" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="VoiceVox 話者ID:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxSpeaker" Grid.Row="2" Grid.Column="1" Width="60"
                                         HorizontalAlignment="Left" Margin="0,4"/>

                                <TextBlock x:Name="txtWebServerInfo" Grid.Row="3" Grid.ColumnSpan="2"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="AI バックエンド状態" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtBackendSummary" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="設定されていません"/>
                                <Button Content="AI 設定を開く" Click="AiSettings_Click" Padding="14,6" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="表示設定" Margin="0,0,0,8" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ミッション詳細フォントサイズ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtMissionFontSize" Width="50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="pt (既定: 14)" VerticalAlignment="Center" Foreground="#666"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="データベース" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtDbPath" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="エクスポート (バックアップ)" Click="ExportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4A90D9" Foreground="White" Margin="0,0,8,0"/>
                                    <Button Content="インポート (復元)" Click="ImportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                </StackPanel>
                                <TextBlock x:Name="txtBackupStatus" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="翻訳DBクリア (全翻訳データ削除)" Click="ClearDb_Click"
                                            Padding="14,6" Foreground="#C00"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="設定を保存" Click="SaveSettings_Click" Style="{StaticResource ActionButton}"
                                FontWeight="Bold" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
