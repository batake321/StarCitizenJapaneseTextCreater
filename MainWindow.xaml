<Window x:Class="StarCitizenJapaneseTextCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater"
        Title="Star Citizen Japanese Text Creator" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GamePath:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtGamePath" Width="400" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbChannel" Width="80" VerticalAlignment="Center" Margin="0,0,4,0"
                          SelectionChanged="Channel_Changed"/>
                <Button Content="参照..." Click="BrowseGamePath_Click" Padding="10,4" Margin="0,0,16,0"/>
                <Button Content="AI 設定" Click="AiSettings_Click" Padding="14,4" FontWeight="Bold"
                        Background="#4A90D9" Foreground="White"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8,4,8,8">
            <!-- 翻訳タブ -->
            <TabItem Header="翻訳">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="btnExtract" Content="1. 抽出" Style="{StaticResource ActionButton}" Click="Extract_Click"/>
                        <Button x:Name="btnTranslate" Content="2. 翻訳" Style="{StaticResource ActionButton}" Click="Translate_Click"/>
                        <Button x:Name="btnApply" Content="3. 反映" Style="{StaticResource ActionButton}" Click="Apply_Click"/>
                        <Button x:Name="btnCancel" Content="中止" Padding="14,6" Margin="16,4,4,4"
                                Background="#D94A4A" Foreground="White" FontWeight="Bold"
                                Click="Cancel_Click" Visibility="Collapsed"/>
                        <TextBlock Text="ゲーム内に付ける印:" VerticalAlignment="Center" Margin="16,4,6,4" Foreground="#555"/>
                        <CheckBox x:Name="chkEquipClassMarks" Content="装備名の分類 [軍1C]"
                                  VerticalAlignment="Center" Margin="0,4,10,4"
                                  Checked="InGameMarks_Changed" Unchecked="InGameMarks_Changed"
                                  ToolTip="装備名の後ろに 分類・サイズ・グレード を付けます"/>
                        <CheckBox x:Name="chkMissionRepMarks" Content="ミッションの派閥と貢献度"
                                  VerticalAlignment="Center" Margin="0,4,10,4"
                                  Checked="InGameMarks_Changed" Unchecked="InGameMarks_Changed"
                                  ToolTip="ミッション名の後ろに [派閥 +貢献度] を付けます"/>
                        <CheckBox x:Name="chkBlueprintMarks" Content="設計図ミッション [BP]"
                                  VerticalAlignment="Center" Margin="0,4,4,4"
                                  Checked="InGameMarks_Changed" Unchecked="InGameMarks_Changed"
                                  ToolTip="設計図がもらえるミッション名の後ろに [BP] を付けます"/>
                    </WrapPanel>

                    <!-- Progress area -->
                    <Grid Grid.Row="1" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="progressBar" Height="22" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="txtProgressPct" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="8,0,0,0" MinWidth="60" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock x:Name="txtProgressDetail" Grid.Row="2" Margin="0,0,0,4"
                               FontFamily="Consolas" FontSize="12" Foreground="#444"/>

                    <TextBox x:Name="txtLog" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                             Background="#1E1E1E" Foreground="#DCDCDC" Padding="4"
                             TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="ログ保存" Click="SaveLog_Click" Padding="12,4"/>
                        <Button Content="ログクリア" Click="ClearLog_Click" Padding="12,4" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 翻訳エディタタブ -->
            <TabItem Header="翻訳エディタ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Width="300" VerticalAlignment="Center" Margin="0,0,4,0"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Content="検索" Click="Search_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <CheckBox x:Name="chkPartialMatch" Content="部分一致" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="PartialMatch_Changed" Unchecked="PartialMatch_Changed"/>
                        <ComboBox x:Name="cmbSearchField" Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="SearchField_Changed">
                            <ComboBoxItem Content="全フィールド" IsSelected="True"/>
                            <ComboBoxItem Content="Key"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbSourceFilter" Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="SourceFilter_Changed">
                            <ComboBoxItem Content="全て" IsSelected="True"/>
                            <ComboBoxItem Content="official"/>
                            <ComboBoxItem Content="ai"/>
                            <ComboBoxItem Content="manual"/>
                            <ComboBoxItem Content="csv"/>
                            <ComboBoxItem Content="glossary"/>
                            <ComboBoxItem Content="original"/>
                            <ComboBoxItem Content="untranslated"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbTranslatorFilter" Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="TranslatorFilter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="txtDbStats" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTranslations" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" RowEditEnding="DgTranslations_RowEditEnding"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8"
                              FontSize="13" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" IsReadOnly="True" SortMemberPath="Key"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="260" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" IsReadOnly="True" SortMemberPath="Source"/>
                            <DataGridTextColumn Header="Translator" Binding="{Binding Translator}" Width="140" IsReadOnly="True" SortMemberPath="Translator"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="130" IsReadOnly="True" SortMemberPath="ModifiedAt"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="◀ 前" Click="PrevPage_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="次 ▶" Click="NextPage_Click" Padding="10,4" Margin="0,0,12,0"/>
                        <CheckBox x:Name="chkSelectAll" Content="全選択" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="SelectAll_Click"/>
                        <Button Content="選択した翻訳を削除 (再翻訳用)" Click="DeleteSelected_Click"
                                Padding="10,4" Margin="0,0,12,0" Foreground="#C00"/>
                        <Button Content="全て原文" Click="SetOriginal_Click"
                                Padding="10,4" Margin="0,0,12,0" ToolTip="選択したレコードの日本語を英語原文のままにする"/>
                        <Button Content="CSV Export" Click="CsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="CsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- 用語集タブ -->
            <TabItem Header="用語集">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="英語→日本語の用語を登録すると、AI翻訳時にプロンプトに含まれます。「一括置換」で既存の翻訳済みテキストにも反映できます。"/>

                    <DataGrid x:Name="dgGlossary" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="350" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="350" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="English:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossEn" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Japanese:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossJa" Grid.Column="3" VerticalAlignment="Center"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="追加/更新" Click="GlossaryAdd_Click" Style="{StaticResource ActionButton}"/>
                        <CheckBox x:Name="chkGlossarySelectAll" Content="全選択" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="GlossarySelectAll_Click"/>
                        <Button Content="選択削除" Click="GlossaryDelete_Click" Style="{StaticResource ActionButton}" Foreground="#C00"/>
                        <Button Content="一括置換 (翻訳済みテキストに適用)" Click="GlossaryBulkReplace_Click"
                                Style="{StaticResource ActionButton}" FontWeight="Bold"/>
                        <Button Content="CSV Export" Click="GlossaryCsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="GlossaryCsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- プロファイルタブ -->
            <TabItem Header="プロファイル">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="キャラクターデザイン" Grid.Column="0" Margin="0,0,4,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCharSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyChar_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="削除" Click="DeleteChar_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCharSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="キーバインド/コントロール設定" Grid.Column="1" Margin="4,0,0,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCtrlSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyCtrl_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="詳細設定" Click="KeybindEditor_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4A90D9" Foreground="White"/>
                                <Button Content="削除" Click="DeleteCtrl_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCtrlSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="txtProfileLog" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Height="150"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- コモディティタブ -->
            <TabItem Header="コモディティ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 条件入力 -->
                    <GroupBox Grid.Row="0" Header="検索条件" Margin="0,0,0,4">
                        <Grid Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="船:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="0"/>
                            <ComboBox x:Name="cmbTradeShip" Grid.Row="0" Grid.Column="1" Margin="0,0,12,0"
                                      SelectionChanged="TradeShip_Changed"/>

                            <TextBlock Text="積載 (SCU):" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="2"/>
                            <TextBox x:Name="txtTradeScu" Grid.Row="0" Grid.Column="3" Margin="0,0,12,0"
                                     Text="100" VerticalAlignment="Center"/>

                            <TextBlock Text="予算 (aUEC):" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="4"/>
                            <TextBox x:Name="txtTradeBudget" Grid.Row="0" Grid.Column="5" Margin="0,0,12,0"
                                     Text="1000000" VerticalAlignment="Center" ToolTip="3M=300万, 500k=50万, 1.5m=150万"/>

                            <TextBlock Text="買い星系:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="6"/>
                            <ComboBox x:Name="cmbTradeBuySystem" Grid.Row="0" Grid.Column="7" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="全て" IsSelected="True"/>
                                <ComboBoxItem Content="Stanton"/>
                                <ComboBoxItem Content="Pyro"/>
                                <ComboBoxItem Content="Nyx"/>
                            </ComboBox>

                            <TextBlock Text="売り星系:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="8"/>
                            <ComboBox x:Name="cmbTradeSellSystem" Grid.Row="0" Grid.Column="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="全て" IsSelected="True"/>
                                <ComboBoxItem Content="Stanton"/>
                                <ComboBoxItem Content="Pyro"/>
                                <ComboBoxItem Content="Nyx"/>
                            </ComboBox>

                            <!-- コモディティフィルタ -->
                            <TextBlock Text="コモディティ:" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Row="0" Grid.Column="10"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="11" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="btnCommodityFilter" Content="コモディティ選択 (全て)" Click="CommodityFilter_Click"
                                        Padding="8,3" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkExcludeOutpost" Content="地上小規模拠点を除く" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkLoadingDockOnly" Content="外部積込対応のみ (Hull C等)"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="chkExcludeLowStock" Content="在庫不足ルートを除く"
                                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Content="ルート検索" Click="TradeSearch_Click" Padding="16,4" Margin="0,0,4,0"
                                        FontWeight="Bold" Background="#1976D2" Foreground="White"/>
                                <Button Content="価格更新" Click="TradeRefresh_Click" Padding="12,4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTradeStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="11"
                                       Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- 結果テーブル -->
                    <DataGrid x:Name="dgTradeRoutes" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA" FontSize="13" RowHeight="52"
                              MouseLeftButtonUp="TradeRoutes_CellClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowBuyStock}" Value="True">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="コモディティ" Binding="{Binding CommodityName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="4,0"/><Setter Property="ToolTip" Value="{Binding CommodityName}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CS" Binding="{Binding ContainerScuDisplay}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#888"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="利益/SCU" Binding="{Binding ProfitDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfitPerScu, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"><Setter Property="Foreground" Value="#1565C0"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ProfitPerScu, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"><Setter Property="Foreground" Value="#D32F2F"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="買値" Binding="{Binding BuyPriceDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="購入場所" Binding="{Binding BuyDisplay}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding BuyDisplay}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="在庫(買)" Binding="{Binding BuyStockDisplay}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="売値" Binding="{Binding SellPriceDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="売却場所" Binding="{Binding SellDisplay}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding SellDisplay}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="在庫(売)" Binding="{Binding SellStockDisplay}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="数量" Binding="{Binding ActualScuDisplay}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="総利益" Binding="{Binding TotalProfitDisplay}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalProfit, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"><Setter Property="Foreground" Value="#1565C0"/></DataTrigger>
                                            <DataTrigger Binding="{Binding TotalProfit, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"><Setter Property="Foreground" Value="#D32F2F"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ROI" Binding="{Binding RoiDisplay}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#666"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="" Binding="{Binding StockWarning}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#D32F2F"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ステータスバー -->
                    <!-- 詳細パネル -->
                    <GroupBox x:Name="grpTradeDetail" Grid.Row="3" Margin="0,4,0,0" MaxHeight="220"
                              Visibility="Collapsed">
                        <GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtDetailHeader" Text="詳細"/>
                                <Button Grid.Column="1" Content="✕" Click="CloseDetail_Click"
                                        Padding="4,0" FontSize="11" Cursor="Hand" Background="Transparent" BorderThickness="0"/>
                            </Grid>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox x:Name="grpDetailLeft" Header="購入場所 (安い順)" Grid.Column="0" Margin="0,0,4,0">
                                <DataGrid x:Name="dgDetailBuy" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          FontSize="12" RowHeight="24" HeadersVisibility="Column"
                                          SelectionChanged="DetailBuy_Selected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="場所/コモディティ" Binding="{Binding Location}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="ToolTip" Value="{Binding Location}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="70"/>
                                        <DataGridTextColumn Header="在庫" Binding="{Binding Stock}" Width="55"/>
                                        <DataGridTextColumn Header="最良売却先" Binding="{Binding BestLocation}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="ToolTip" Value="{Binding BestLocation}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BestLocation}" Value=""><Setter Property="ToolTip" Value="{x:Null}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BestLocation}" Value="-"><Setter Property="ToolTip" Value="{x:Null}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="差益/SCU" Binding="{Binding Profit}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#888"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasCounterpart}" Value="True"/>
                                                                <Condition Binding="{Binding ProfitValue, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasCounterpart}" Value="True"/>
                                                                <Condition Binding="{Binding ProfitValue, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox x:Name="grpDetailRight" Header="売却場所 (高い順)" Grid.Column="1" Margin="4,0,0,0">
                                <DataGrid x:Name="dgDetailSell" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          FontSize="12" RowHeight="24" HeadersVisibility="Column"
                                          SelectionChanged="DetailSell_Selected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="場所/コモディティ" Binding="{Binding Location}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="ToolTip" Value="{Binding Location}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="70"/>
                                        <DataGridTextColumn Header="在庫" Binding="{Binding Stock}" Width="55"/>
                                        <DataGridTextColumn Header="最安仕入先" Binding="{Binding BestLocation}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="ToolTip" Value="{Binding BestLocation}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BestLocation}" Value=""><Setter Property="ToolTip" Value="{x:Null}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BestLocation}" Value="-"><Setter Property="ToolTip" Value="{x:Null}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="差益/SCU" Binding="{Binding Profit}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="#888"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasCounterpart}" Value="True"/>
                                                                <Condition Binding="{Binding ProfitValue, Converter={x:Static local:PositiveConverter.Instance}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasCounterpart}" Value="True"/>
                                                                <Condition Binding="{Binding ProfitValue, Converter={x:Static local:PositiveConverter.Instance}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <TextBlock x:Name="txtTradeInfo" Grid.Row="4" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <!-- 船舶管理タブ -->
            <TabItem Header="船舶管理">
                <TabControl x:Name="tabShipManagement" Margin="4">
                    <TabItem Header="所持船">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ヘッダー -->
                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#333">
                        所持している船を管理します。コモディティタブの船セレクタに反映されます。UEX船データから選択するか、手動で追加できます。
                    </TextBlock>

                    <!-- 所持船一覧 -->
                    <DataGrid x:Name="dgMyShips" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA" FontSize="13" RowHeight="30"
                              HorizontalScrollBarVisibility="Auto"
                              MouseDoubleClick="MyShip_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="船名" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="ToolTip" Value=" "/>
                                        <EventSetter Event="ToolTipOpening" Handler="ShipTooltip_Opening"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="積載 (SCU)" Binding="{Binding Scu}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="メモ" Binding="{Binding Notes}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="ToolTip" Value="{Binding Notes}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ローナー" Binding="{Binding LoanerDisplay}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="ToolTip" Value="{Binding LoanerDisplay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoanerDisplay}" Value=""><Setter Property="ToolTip" Value="{x:Null}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="保有数" Binding="{Binding HangarCountDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#9C5B08"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HangarCount}" Value="0">
                                                <Setter Property="Foreground" Value="#999"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="由来" Binding="{Binding HangarOriginDisplay}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding HangarOriginDisplay}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Upgradable" Binding="{Binding HangarUpgradableDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="販売" Binding="{Binding HangarSaleDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="購入可" Binding="{Binding HangarStoreUpgradeDisplay}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="アップグレード" IsEnabled="{Binding HangarCanUpgrade}"
                                                    Click="MyShipUpgrade_Click" Padding="6,2" Margin="2"
                                                    MinWidth="96" FontSize="11"/>
                                            <Button Content="装備" ToolTip="装備タブでこの船の装備を確認・設定します"
                                                    Click="OpenLoadout_Click" Padding="6,2" Margin="2"
                                                    MinWidth="48" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="追加日" Binding="{Binding AddedAt}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/><Setter Property="FontSize" Value="11"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- UEX船検索 + 追加 -->
                    <GroupBox Grid.Row="2" Header="船を追加" Margin="0,8,0,0">
                        <Grid Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: 検索 + 候補選択 -->
                            <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtShipSearch" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center"
                                     KeyDown="ShipSearch_KeyDown" ToolTip="船名を入力して検索 or Enter"/>
                            <Button Content="検索" Grid.Column="2" Click="ShipSearch_Click" Padding="8,3" Margin="0,0,8,0"/>
                            <TextBlock Text="候補:" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="cmbAddShip" Grid.Column="4" Grid.ColumnSpan="4" MinWidth="280"
                                      DisplayMemberPath="DisplayName" SelectionChanged="AddShip_Selected" Margin="0,0,8,0"/>
                            <CheckBox x:Name="chkAddShipInGame" Content="ゲーム内購入 (aUEC)" Grid.Column="8" Grid.ColumnSpan="2"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="pledge ではなくゲーム内で aUEC 購入した船として登録します (メモの先頭に [ゲーム内購入] が付きます)"/>

                            <!-- Row 1: 詳細入力 -->
                            <TextBlock Text="船名:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <ComboBox x:Name="cmbAddShipName" Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" VerticalAlignment="Center"
                                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="260"
                                      TextBoxBase.TextChanged="AddShipName_TextChanged" LostFocus="AddShipName_LostFocus"
                                      ToolTip="3 文字以上入力すると候補が出ます。船名からメーカーを自動で入れます"/>
                            <TextBlock Text="メーカー:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <ComboBox x:Name="cmbAddShipMfr" Grid.Row="1" Grid.Column="4" Margin="0,4,8,0" VerticalAlignment="Center"
                                      MinWidth="120" IsEditable="True" IsTextSearchEnabled="True"
                                      ToolTip="一覧から選ぶか、直接入力できます (空のままでも船名から自動で判別します)"/>
                            <TextBlock Text="SCU:" Grid.Row="1" Grid.Column="6" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipScu" Grid.Row="1" Grid.Column="7" Text="0" Margin="0,4,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="メモ:" Grid.Row="1" Grid.Column="8" VerticalAlignment="Center" Margin="0,4,4,0"/>
                            <TextBox x:Name="txtAddShipNotes" Grid.Row="1" Grid.Column="9" Margin="0,4,8,0" VerticalAlignment="Center"/>
                            <Button Content="追加" Grid.Row="1" Grid.Column="10" Click="AddMyShip_Click" Padding="16,4" Margin="0,4,0,0"
                                    FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                        </Grid>
                    </GroupBox>

                    <!-- 操作ボタン -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btnSyncMyShips" Content="My Hangar と同期" Click="HangarSync_Click" Padding="12,6" Margin="0,0,8,0" Background="#1976D2" Foreground="White" FontWeight="Bold"/>
                        <Button Content="同期した船を所持船に反映" Click="ImportHangarShips_Click" Padding="12,4" Margin="0,0,8,0"
                                ToolTip="My Hangar と同期した保有船のうち、所持船に無いものを追加します"/>
                        <Button Content="選択を更新" Click="UpdateMyShip_Click" Padding="12,4" Margin="0,0,4,0"/>
                        <Button Content="選択を削除" Click="DeleteMyShip_Click" Padding="12,4" Margin="0,0,8,0" Foreground="#D32F2F"/>
                        <Button Content="ワイプ" Click="ShipWipe_Click" Padding="12,4" Margin="0,0,8,0"
                                Foreground="White" Background="#B71C1C" FontWeight="Bold"
                                ToolTip="サーバーワイプで無くなる船を選んでまとめて削除します"/>
                        <TextBlock x:Name="txtMyShipStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                    </StackPanel>
                </Grid>
                    </TabItem>
                    <TabItem x:Name="tabUpgradeManage" Header="アップグレード管理">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="btnSync" Content="My Hangar と同期" Click="HangarSync_Click" Padding="12,6" Margin="0,0,8,0"
                                        Background="#1976D2" Foreground="White" FontWeight="Bold"/>
                                <Button x:Name="btnUpgradeReload" Content="再読み込み" Click="UpgradeReload_Click" Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="btnUpgradeReset" Content="シミュレーションをリセット" Click="UpgradeReset_Click" Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="btnStoreRefresh" Content="ストア情報を更新" Click="StoreRefresh_Click" Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="btnRebuildEquipment" Content="装備データを再抽出" Click="RebuildEquipment_Click" Padding="12,6" Margin="0,0,8,0"
                                        ToolTip="Data.p4k から船と装備 (item_index) のデータだけを再抽出します (数分)。初期装備 (デフォルトロードアウト) を正しく取り直すときに使います"/>
                                <TextBlock x:Name="txtUpgradeStatus" VerticalAlignment="Center" Foreground="#666"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <GroupBox Header="保有船のアップグレード">
                                    <DataGrid x:Name="dgUpgradeShips" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              FontSize="13" RowHeight="30" HeadersVisibility="Column"
                                              HorizontalScrollBarVisibility="Auto"
                                              MouseDoubleClick="UpgradeCcu_DoubleClick">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeadEnd}" Value="True">
                                                        <Setter Property="Foreground" Value="#999"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasApplied}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                        <Setter Property="Background" Value="#FFF8E1"/>
                                                    </DataTrigger>
                                                    <!-- Hangar に一致しない所持船 (ゲーム内購入 / 手入力): pledge ではないので控えめな色
                                                         (IsDeadEnd の灰より後ろに置いて優先、IsUnresolved の赤より前に置いて未解決の警告は残す) -->
                                                    <DataTrigger Binding="{Binding IsInGame}" Value="True">
                                                        <Setter Property="Foreground" Value="#555"/>
                                                        <Setter Property="Background" Value="#FAFAFA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                        <Setter Property="Foreground" Value="#555"/>
                                                        <Setter Property="Background" Value="#FAFAFA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                    <!-- アップグレード (CCU) 行: 使用可 = 緑 / 使用中 = 紫 (使ったと分かるように使用可と明確に区別) / 使用不可 = 灰文字 / 売却予定 = IsSold (桃) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCcu}" Value="True"/>
                                                            <Condition Binding="{Binding CcuState}" Value="使用可"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCcu}" Value="True"/>
                                                            <Condition Binding="{Binding CcuState}" Value="使用中"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#EDE7F6"/>
                                                        <Setter Property="Foreground" Value="#4527A0"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsCcuUnusable}" Value="True">
                                                        <Setter Property="Foreground" Value="#999"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSold}" Value="True">
                                                        <Setter Property="Foreground" Value="#999"/>
                                                        <Setter Property="Background" Value="#FCE4EC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="船名" Width="260" MinWidth="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding ToggleLabel}" Click="UpgradeGroupToggle_Click"
                                                                    Width="24" Height="22" Padding="0" Margin="2,0,4,0" FontSize="11"
