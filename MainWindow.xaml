<Window x:Class="StarCitizenJapaneseTextCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenJapaneseTextCreater"
        Title="Star Citizen Japanese Text Creator" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GamePath:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtGamePath" Width="400" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbChannel" Width="80" VerticalAlignment="Center" Margin="0,0,4,0"
                          SelectionChanged="Channel_Changed"/>
                <Button Content="参照..." Click="BrowseGamePath_Click" Padding="10,4" Margin="0,0,16,0"/>
                <Button Content="AI 設定" Click="AiSettings_Click" Padding="14,4" FontWeight="Bold"
                        Background="#4A90D9" Foreground="White"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8,4,8,8">
            <!-- 翻訳タブ -->
            <TabItem Header="翻訳">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="btnExtract" Content="1. 抽出" Style="{StaticResource ActionButton}" Click="Extract_Click"/>
                        <Button x:Name="btnTranslate" Content="2. 翻訳" Style="{StaticResource ActionButton}" Click="Translate_Click"/>
                        <Button x:Name="btnApply" Content="3. 反映" Style="{StaticResource ActionButton}" Click="Apply_Click"/>
                        <Button x:Name="btnCancel" Content="中止" Padding="14,6" Margin="16,4,4,4"
                                Background="#D94A4A" Foreground="White" FontWeight="Bold"
                                Click="Cancel_Click" Visibility="Collapsed"/>
                    </WrapPanel>

                    <!-- Progress area -->
                    <Grid Grid.Row="1" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="progressBar" Height="22" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="txtProgressPct" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="8,0,0,0" MinWidth="60" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock x:Name="txtProgressDetail" Grid.Row="2" Margin="0,0,0,4"
                               FontFamily="Consolas" FontSize="12" Foreground="#444"/>

                    <TextBox x:Name="txtLog" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                             Background="#1E1E1E" Foreground="#DCDCDC" Padding="4"
                             TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="ログ保存" Click="SaveLog_Click" Padding="12,4"/>
                        <Button Content="ログクリア" Click="ClearLog_Click" Padding="12,4" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 翻訳エディタタブ -->
            <TabItem Header="翻訳エディタ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Width="300" VerticalAlignment="Center" Margin="0,0,4,0"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Content="検索" Click="Search_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbSearchField" Width="110" VerticalAlignment="Center" Margin="0,0,8,0">
                            <ComboBoxItem Content="全フィールド" IsSelected="True"/>
                            <ComboBoxItem Content="Key"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbSourceFilter" Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="SourceFilter_Changed">
                            <ComboBoxItem Content="全て" IsSelected="True"/>
                            <ComboBoxItem Content="official"/>
                            <ComboBoxItem Content="ai"/>
                            <ComboBoxItem Content="manual"/>
                            <ComboBoxItem Content="csv"/>
                            <ComboBoxItem Content="glossary"/>
                            <ComboBoxItem Content="untranslated"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbTranslatorFilter" Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="TranslatorFilter_Changed"/>
                        <Button Content="DB読込" Click="LoadDb_Click" Padding="10,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="txtDbStats" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTranslations" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" RowEditEnding="DgTranslations_RowEditEnding"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8"
                              FontSize="13" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" IsReadOnly="True" SortMemberPath="Key"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="260" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" IsReadOnly="True" SortMemberPath="Source"/>
                            <DataGridTextColumn Header="Translator" Binding="{Binding Translator}" Width="140" IsReadOnly="True" SortMemberPath="Translator"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="130" IsReadOnly="True" SortMemberPath="ModifiedAt"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="◀ 前" Click="PrevPage_Click" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="次 ▶" Click="NextPage_Click" Padding="10,4" Margin="0,0,12,0"/>
                        <CheckBox x:Name="chkSelectAll" Content="全選択" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="SelectAll_Click"/>
                        <Button Content="選択した翻訳を削除 (再翻訳用)" Click="DeleteSelected_Click"
                                Padding="10,4" Margin="0,0,12,0" Foreground="#C00"/>
                        <Button Content="CSV Export" Click="CsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="CsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- 用語集タブ -->
            <TabItem Header="用語集">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="英語→日本語の用語を登録すると、AI翻訳時にプロンプトに含まれます。「一括置換」で既存の翻訳済みテキストにも反映できます。"/>

                    <DataGrid x:Name="dgGlossary" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="350" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Japanese" Binding="{Binding Japanese}" Width="350" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="English:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossEn" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Japanese:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtGlossJa" Grid.Column="3" VerticalAlignment="Center"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="追加/更新" Click="GlossaryAdd_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="削除" Click="GlossaryDelete_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="一括置換 (翻訳済みテキストに適用)" Click="GlossaryBulkReplace_Click"
                                Style="{StaticResource ActionButton}" FontWeight="Bold"/>
                        <Button Content="CSV Export" Click="GlossaryCsvExport_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="CSV Import" Click="GlossaryCsvImport_Click" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- プロファイルタブ -->
            <TabItem Header="プロファイル">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="キャラクターデザイン" Grid.Column="0" Margin="0,0,4,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCharSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyChar_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyChar_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="削除" Click="DeleteChar_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCharSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="キーバインド/コントロール設定" Grid.Column="1" Margin="4,0,0,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="lstCtrlSaves" Grid.Row="0" MinHeight="200"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="ゲームから保存" Click="SaveCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="外部から取込" Click="ImportCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                                <Button Content="コピー" Click="CopyCtrl_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2">
                                <Button Content="ゲームに反映" Click="ApplyCtrl_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                <Button Content="詳細設定" Click="KeybindEditor_Click" Padding="10,4" Margin="0,0,4,4"
                                        FontWeight="Bold" Background="#4A90D9" Foreground="White"/>
                                <Button Content="削除" Click="DeleteCtrl_Click" Padding="10,4" Margin="0,0,4,4" Foreground="#C00"/>
                                <Button Content="更新" Click="RefreshCtrlSaves_Click" Padding="10,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="txtProfileLog" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Height="150"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- チャットタブ -->
            <TabItem Header="チャット">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: backend selector + data fetch toggle -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="AI バックエンド:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbChatBackend" Width="200" VerticalAlignment="Center" Margin="0,0,16,0"
                                  SelectionChanged="CmbChatBackend_SelectionChanged"/>
                        <CheckBox x:Name="chkFetchScData" Content="スキル使用 (API/DB検索)"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="履歴クリア" Click="ChatClear_Click" Padding="10,4" VerticalAlignment="Center"/>
                        <Button Content="全体コピー" Click="ChatCopyAll_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Content="記憶管理" Click="KnowledgeManage_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Chat messages area -->
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                        <ScrollViewer x:Name="svChat" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icChatMessages">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,8" CornerRadius="8"
                                                Background="{Binding Background}"
                                                HorizontalAlignment="{Binding Alignment}">
                                            <Border.MaxWidth>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                         Converter="{x:Static local:ChatWidthConverter.Instance}"/>
                                            </Border.MaxWidth>
                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{x:Static local:ChatTemplateSelector.Instance}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Input area -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput" Grid.Column="0" AcceptsReturn="False"
                                 TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Padding="8,6"
                                 PreviewKeyDown="ChatInput_PreviewKeyDown"/>
                        <Button x:Name="btnChatSend" Grid.Column="1" Content="送信" Click="ChatSend_Click"
                                Padding="20,8" Margin="8,0,0,0" FontWeight="Bold"
                                Background="#4A90D9" Foreground="White" FontSize="13"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 設定タブ -->
            <TabItem Header="設定">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="基本設定" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="GamePath:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtSettingsGamePath" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Working Directory:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtWorkDir" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Output Language:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtOutputLang" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Star Citizen API (チャット用)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="SC API Key:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtScApiKey" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" Foreground="#666" TextWrapping="Wrap"
                                           Text="starcitizen-api.com の API キー。Discord で /api register コマンドで取得できます。"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="ゲームデータ連携 (Data.p4k)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"
                                           Text="StarBreaker CLI で Data.p4k からゲーム内データ（船・武器・コンポーネント・契約）を抽出しDBに格納します。インデックス構築（約2分半）でパッチ毎のデータをキャッシュし、FTS5 全文検索で日本語・あいまい検索が可能になります。ベクトル検索構築は「AI 設定」のバックエンド（Ollama優先）を使用し約2分15秒（合計約5分）。"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnExtractGameData" Content="インデックス構築"
                                            Click="ExtractGameData_Click" Padding="14,6"
                                            FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                    <Button x:Name="btnBuildVectorIndex" Content="ベクトル検索構築"
                                            Click="BuildVectorIndex_Click" Padding="14,6" Margin="8,0,0,0"
                                            FontWeight="Bold" Background="#9C27B0" Foreground="White"
                                            ToolTip="Ollama/OpenAI/Gemini のエンベディングモデルでセマンティック検索を有効化（バックグラウンド実行）"/>
                                    <TextBlock x:Name="txtGameDataStatus" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="#666"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="pbGameData" Height="20" Minimum="0" Maximum="100"/>
                                    <TextBlock x:Name="txtGameDataPct" Grid.Column="1" VerticalAlignment="Center"
                                               Margin="8,0,0,0" MinWidth="50" FontWeight="Bold"/>
                                </Grid>

                                <TextBlock x:Name="txtGameDataDetail" Grid.Row="3" Foreground="#444"
                                           FontFamily="Consolas" FontSize="12"/>

                                <TextBlock x:Name="txtSearchIndexStatus" Grid.Row="4" Margin="0,4,0,0" Foreground="#666"
                                           FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Web チャットサーバー" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="HTTP ポート:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <TextBox x:Name="txtWebPort" Width="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="HTTPS:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox x:Name="txtWebHttpsPort" Width="60" VerticalAlignment="Center"/>
                                    <Button x:Name="btnWebServer" Content="サーバー起動" Click="WebServer_Click"
                                            Padding="14,4" Margin="8,0,0,0" FontWeight="Bold"
                                            Background="#4A90D9" Foreground="White"/>
                                    <CheckBox x:Name="chkWebAutoStart" Content="自動起動" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="VoiceVox URL:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxUrl" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="VoiceVox 話者ID:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxSpeaker" Grid.Row="2" Grid.Column="1" Width="60"
                                         HorizontalAlignment="Left" Margin="0,4"/>

                                <TextBlock x:Name="txtWebServerInfo" Grid.Row="3" Grid.ColumnSpan="2"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="AI バックエンド状態" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtBackendSummary" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="設定されていません"/>
                                <Button Content="AI 設定を開く" Click="AiSettings_Click" Padding="14,6" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="データベース" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtDbPath" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="エクスポート (バックアップ)" Click="ExportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4A90D9" Foreground="White" Margin="0,0,8,0"/>
                                    <Button Content="インポート (復元)" Click="ImportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                </StackPanel>
                                <TextBlock x:Name="txtBackupStatus" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="翻訳DBクリア (全翻訳データ削除)" Click="ClearDb_Click"
                                            Padding="14,6" Foreground="#C00"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="設定を保存" Click="SaveSettings_Click" Style="{StaticResource ActionButton}"
                                FontWeight="Bold" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
