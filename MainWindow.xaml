                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCcu}" Value="True"/>
                                                                    <Condition Binding="{Binding CcuState}" Value="使用可"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="価格" Binding="{Binding PriceDisplay}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="割引" Binding="{Binding DiscountDisplay}" Width="60">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#0E6555"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="権利種別" Binding="{Binding WarbondDisplay}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#9C5B08"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="役割" Binding="{Binding Focus}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="ToolTip" Value="{Binding Focus}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="種別" Binding="{Binding Type}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="実装" Binding="{Binding Status}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="in-concept">
                                                                <Setter Property="Foreground" Value="#9C5B08"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="販売" Binding="{Binding OnSaleDisplay}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OnSaleWarbond}" Value="True">
                                                                <Setter Property="Foreground" Value="#9C5B08"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Upgradable" Binding="{Binding UpgradableDisplay}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="購入可" Binding="{Binding StoreUpgradeDisplay}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="マーク" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{x:Static local:MainWindow.MarkChoices}"
                                                                  SelectedItem="{Binding MarkDisplay, Mode=OneWay}"
                                                                  SelectionChanged="UpgradeMark_Changed"
                                                                  IsEnabled="{Binding MarkEnabled}"
                                                                  FontSize="11" Margin="2" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="適用後" Binding="{Binding AppliedDisplay}" Width="180">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="" Width="270">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Upgrade" IsEnabled="{Binding UpgradeEnabled}"
                                                                    Click="UpgradeApply_Click" Padding="6,2" Margin="2"
                                                                    MinWidth="64" FontSize="11"/>
                                                            <Button Content="Undo" IsEnabled="{Binding UndoEnabled}"
                                                                    Click="UpgradeUndo_Click" Padding="6,2" Margin="2"
                                                                    MinWidth="48" FontSize="11"/>
                                                            <Button Content="{Binding SellLabel}" IsEnabled="{Binding SellEnabled}"
                                                                    ToolTip="{Binding SellToolTip}" ToolTipService.ShowOnDisabled="True"
                                                                    Click="UpgradeSell_Click" Padding="6,2" Margin="2"
                                                                    MinWidth="56" FontSize="11"/>
                                                            <Button Content="装備" IsEnabled="{Binding LoadoutEnabled}"
                                                                    ToolTip="装備タブでこの船の装備を確認・設定します" ToolTipService.ShowOnDisabled="True"
                                                                    Click="OpenLoadout_Click" Padding="6,2" Margin="2"
                                                                    MinWidth="48" FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock x:Name="txtUpgradeSummary" Foreground="#666" FontSize="12"/>
                                <TextBlock x:Name="txtSellLtiWarning" Text="⚠ LTI を失う pledge があります"
                                           Foreground="#D32F2F" FontWeight="Bold" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <Expander Grid.Row="3" Header="販売中の船 (RSI ストア)" IsExpanded="True" Margin="0,8,0,0">
                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <CheckBox x:Name="chkStoreWarbondOnly" Content="Warbond のみ" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Checked="StoreFilter_Changed" Unchecked="StoreFilter_Changed"/>
                                        <TextBlock Text="カテゴリ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="cmbStoreCategory" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  SelectionChanged="StoreFilter_Changed"/>
                                        <TextBlock x:Name="txtStoreStatus" VerticalAlignment="Center" Foreground="#666"/>
                                    </StackPanel>
                                    <DataGrid x:Name="dgStore" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              FontSize="12" RowHeight="26" HeadersVisibility="Column" MaxHeight="260"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarbond}" Value="True">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="130">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="船/商品" Binding="{Binding Name}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="税抜 USD" Binding="{Binding NativePriceDisplay}" Width="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="種別" Binding="{Binding WarbondDisplay}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#9C5B08"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="在庫" Binding="{Binding StockLevel}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="保有" Binding="{Binding OwnedDisplay}" Width="60">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#1565C0"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Expander>

                            <Expander Grid.Row="4" Header="プランナー / melt シミュレーション" IsExpanded="False" Margin="0,8,0,0">
                                <Grid MaxHeight="320" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Header="プランナー" Grid.Column="0" Margin="0,0,4,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Button Content="提案を計算" Click="UpgradePlan_Click" Padding="12,4" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="txtPlanSummary" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                            </StackPanel>
                                            <DataGrid x:Name="dgPlan" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      FontSize="12" RowHeight="26" HeadersVisibility="Column"
                                                      HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="melt">
                                                                <Setter Property="Foreground" Value="#9C5B08"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="使用不可">
                                                                <Setter Property="Foreground" Value="#999"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="70"/>
                                                    <DataGridTextColumn Header="内容" Binding="{Binding Detail}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="額" Binding="{Binding AmountDisplay}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="melt シミュレーション" Grid.Column="1" Margin="4,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="txtBuybackTokens" Grid.Row="0" Text="Buy Back 残トークン: 未取得"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <DataGrid x:Name="dgMeltPledges" Grid.Row="1" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      FontSize="12" RowHeight="26" HeadersVisibility="Column"
                                                      HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Meltable}" Value="False">
                                                                <Setter Property="Foreground" Value="#999"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="melt" Width="44">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding CanSelect}"
                                                                          ToolTip="{Binding SelectToolTip}" ToolTipService.ShowOnDisabled="True"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="pledge" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Name}"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="melt額" Binding="{Binding ValueDisplay}" Width="80" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="保険" Binding="{Binding InsuranceDisplay}" Width="60" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="船" Binding="{Binding Ships}" Width="*" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Ships}"/></Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="目標価格 (USD):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="txtMeltTarget" Width="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="計算" Click="MeltSim_Click" Padding="12,4"/>
                                            </StackPanel>
                                            <TextBlock x:Name="txtMeltLtiWarning" Grid.Row="3" Text="⚠ LTI を失います"
                                                       Foreground="#D32F2F" FontWeight="Bold" Margin="0,4,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="txtMeltResult" Grid.Row="4" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Expander>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabLoadout" Header="装備">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#333" TextWrapping="Wrap">
                                所持しているコンポーネント (パワープラント / シールド / クーラー / 量子ドライブ / 武器 等) を使用可否を含めて登録し、保有船ごとに現在の装備を設定します。未設定のポートはデフォルト装備を表示します。設定内容は船名のツールチップに反映されます。
                            </TextBlock>

                            <!-- 上段: 所持コンポーネント -->
                            <GroupBox Grid.Row="1" Header="所持コンポーネント" Margin="0,0,0,4">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="dgMyComponents" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                                              AlternatingRowBackground="#FAFAFA" FontSize="12" RowHeight="26" HeadersVisibility="Column"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Usable}" Value="False">
                                                        <Setter Property="Foreground" Value="#999"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="種別" Binding="{Binding TypeDisplay}" Width="110" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="名称" Binding="{Binding ItemName}" Width="200" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="ToolTip" Value=" "/>
                                                        <EventSetter Event="ToolTipOpening" Handler="ComponentTooltip_Opening"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="50" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Class" Binding="{Binding GradeDisplay}" Width="50" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="50" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <!-- 使用可: MyComponentRow.Usable の setter が DB へ書き戻す (CellEditEnding には依存しない) -->
                                            <DataGridCheckBoxColumn Header="使用可" Width="60" IsReadOnly="False"
                                                                    Binding="{Binding Usable, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="メモ" Binding="{Binding Notes}" Width="*" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#666"/>
                                                        <Setter Property="ToolTip" Value="{Binding Notes}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="追加日" Binding="{Binding AddedAt}" Width="130" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/><Setter Property="FontSize" Value="11"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 追加パネル -->
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="種別:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="cmbCompType" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  DisplayMemberPath="DisplayName" SelectionChanged="CompType_Changed"/>
                                        <TextBlock Text="検索:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="txtCompSearch" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 TextChanged="CompSearch_TextChanged" ToolTip="名称 / メーカー / レコード名の一部で絞り込み"/>
                                        <TextBlock Text="候補:" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="cmbCompCandidates" Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  DisplayMemberPath="Display" MinWidth="200">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBlock Text="数量:" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="txtCompQty" Grid.Column="7" Text="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="chkCompUsable" Grid.Column="8" Content="使用可" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="メモ:" Grid.Column="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="txtCompNotes" Grid.Column="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Button Content="追加" Grid.Column="11" Click="AddMyComponent_Click" Padding="16,4"
                                                FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="選択を削除" Click="DeleteMyComponent_Click" Padding="12,4" Margin="0,0,8,0" Foreground="#D32F2F"/>
                                        <TextBlock x:Name="txtCompStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 下段: 現在の装備 -->
                            <GroupBox Grid.Row="2" Header="現在の装備" Margin="0,4,0,0">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="船:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="cmbLoadoutShip" Width="320" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  DisplayMemberPath="Display" SelectionChanged="LoadoutShip_Changed"/>
                                        <Button Content="全てデフォルトに戻す" Click="LoadoutReset_Click" Padding="12,4" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="txtLoadoutStatus" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                    </StackPanel>
                                    <DataGrid x:Name="dgLoadout" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              FontSize="12" RowHeight="28" HeadersVisibility="Column"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="種別" Binding="{Binding TypeDisplay}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ポート" Binding="{Binding PortName}" Width="200">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#666"/>
                                                        <Setter Property="ToolTip" Value="{Binding PortName}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ポートSize" Binding="{Binding PortSizeDisplay}" Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="デフォルト" Binding="{Binding DefaultItemName}" Width="170">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="ToolTip" Value=" "/>
                                                        <EventSetter Event="ToolTipOpening" Handler="LoadoutDefaultTooltip_Opening"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="現在" Binding="{Binding EffectiveItemName}" Width="170">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#666"/>
                                                        <Setter Property="ToolTip" Value=" "/>
                                                        <EventSetter Event="ToolTipOpening" Handler="LoadoutCurrentTooltip_Opening"/>
                                                        <Style.Triggers>
                                                            <!-- 設定済みポートだけ太字・青。未設定ポートは初期装備を控えめな色で出す -->
                                                            <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#1565C0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Size" Binding="{Binding ItemSizeDisplay}" Width="50">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Class" Binding="{Binding ItemGradeDisplay}" Width="50">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="装備を設定" Width="260">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Candidates}" DisplayMemberPath="Display"
                                                                  SelectedItem="{Binding SelectedChoice, Mode=OneWay}"
                                                                  SelectionChanged="LoadoutItem_Changed"
                                                                  IsEnabled="{Binding HasCandidates}"
                                                                  ToolTip="所持コンポーネントのうち同じ種別・ポート Size 以下・使用可のものが候補になります"
                                                                  FontSize="11" Margin="2" VerticalAlignment="Center">
                                                            <ComboBox.ItemContainerStyle>
                                                                <Style TargetType="ComboBoxItem">
                                                                    <Setter Property="ToolTip" Value=" "/>
                                                                    <EventSetter Event="ToolTipOpening" Handler="LoadoutChoiceTooltip_Opening"/>
                                                                </Style>
                                                            </ComboBox.ItemContainerStyle>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- 価格キャプチャタブ -->
            <TabItem Header="価格キャプチャ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- コントロールバー -->
                    <GroupBox Grid.Row="0" Header="キャプチャ設定" Margin="0,0,0,4">
                        <StackPanel Margin="8,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="手動キャプチャ (画面全体)" Click="ManualCapture_Click"
                                        Padding="12,4" Margin="0,0,8,0" Background="#1976D2" Foreground="White" FontWeight="Bold"/>
                                <Button Content="クリップボードから読取" Click="ClipboardCapture_Click"
                                        Padding="12,4" Margin="0,0,8,0"/>
                                <Button Content="ファイルから読取" Click="FileCapture_Click"
                                        Padding="12,4" Margin="0,0,16,0"/>
                                <CheckBox x:Name="chkHotkeyEnabled" Content="PrintScreenホットキー有効"
                                          VerticalAlignment="Center" IsChecked="True"
                                          Checked="HotkeyEnabled_Changed" Unchecked="HotkeyEnabled_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="txtCaptureStatus" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- メインコンテンツ: プレビュー + パース結果 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左: スクリーンショットプレビュー -->
                        <GroupBox Header="キャプチャ画像" Grid.Column="0" Margin="0,0,4,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="imgCapturePreview" Stretch="Uniform"/>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 右: パース結果 -->
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ターミナル情報 -->
                            <GroupBox Header="認識結果" Grid.Row="0" Margin="0,0,0,4">
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ターミナル:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="cmbCaptureTerminal" Grid.Column="1" IsEditable="True"
                                              DisplayMemberPath="Key" SelectedValuePath="Value"/>
                                    <TextBlock Text="モード:" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <ComboBox x:Name="cmbCaptureMode" Grid.Column="3">
                                        <ComboBoxItem Content="BUY" IsSelected="True"/>
                                        <ComboBoxItem Content="SELL"/>
                                    </ComboBox>
                                    <TextBlock Text="信頼度:" Grid.Column="4" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBlock x:Name="txtOcrConfidence" Grid.Column="5" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontWeight="Bold"/>
                                </Grid>
                            </GroupBox>

                            <!-- コモディティデータグリッド (編集可能) -->
                            <DataGrid x:Name="dgCapturedCommodities" Grid.Row="1"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="True" IsReadOnly="False"
                                      GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA"
                                      FontSize="13" RowHeight="30">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsMatched}" Width="30"/>
                                    <DataGridTextColumn Header="コモディティ" Binding="{Binding MatchedName}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="OCR原文" Binding="{Binding RawName}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#999"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="在庫(SCU)" Binding="{Binding Inventory}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="信頼度" Binding="{Binding MatchConfidence, StringFormat=P0}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- 下部: アクションボタン + ステータス -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSubmitUex" Content="UEXに送信" Click="SubmitUex_Click"
                                Padding="14,6" Margin="0,0,8,0" FontWeight="Bold" Background="#FF6F00" Foreground="White"/>
                        <CheckBox x:Name="chkCaptureScreenshot" Content="スクリーンショットも送信"
                                  Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="クリア" Grid.Column="2" Click="ClearCapture_Click" Padding="12,4" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtSubmitStatus" Grid.Column="4" VerticalAlignment="Center"
                                   Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtOcrTiming" Grid.Column="5" VerticalAlignment="Center"
                                   Foreground="#999" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ミッションタブ -->
            <TabItem Header="ミッション">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Category list -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="カテゴリ" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <Button Grid.Row="1" x:Name="btnLoadMissions" Content="ミッション読み込み"
                                Click="LoadMissions_Click" Padding="10,6" Margin="0,0,0,8"
                                FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                        <ListBox Grid.Row="2" x:Name="lstMissionCategories"
                                 SelectionChanged="MissionCategory_Changed"
                                 FontSize="13" Padding="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="4,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="3" x:Name="txtMissionStatus" Foreground="#666"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Right: Mission list + detail -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- Search bar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="組合:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                <ComboBox x:Name="cmbMissionFaction" Width="200" FontSize="12"
                                          SelectionChanged="MissionFilter_Changed"/>
                                <TextBlock Text="ランク:" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="12"/>
                                <ComboBox x:Name="cmbMissionRank" Width="180" FontSize="12"
                                          SelectionChanged="MissionFilter_Changed"/>
                                <TextBlock x:Name="txtMissionSearchStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtMissionSearch" Width="300" Padding="4,3"
                                         FontSize="13" KeyDown="MissionSearch_KeyDown"
                                         ToolTip="英語名・日本語名・依頼者で検索 (*前方一致, 後方一致*, 部分一致)"/>
                                <Button Content="検索" Click="MissionSearch_Click" Padding="12,3" Margin="4,0,0,0"/>
                                <Button Content="クリア" Click="MissionSearchClear_Click" Padding="12,3" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mission list -->
                        <DataGrid Grid.Row="1" x:Name="dgMissions" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionChanged="Mission_Selected"
                                  CanUserSortColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="名前" Width="320" SortMemberPath="CleanedName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2">
                                                <TextBlock Text="{Binding DisplayNameJa}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="Black" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DisplayNameJa, Converter={x:Static local:StringToVisConverter.Instance}}"/>
                                                <TextBlock Text="{Binding DisplayNameEn}" Foreground="#333" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="難易度" Binding="{Binding Difficulty}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="報酬 (aUEC)" Binding="{Binding DisplayReward}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="場所" Binding="{Binding Location}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="#DDD" Margin="0,2"/>

                        <!-- Mission detail -->
                        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txtMissionDetail" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="14"
                                           Foreground="#DCDCDC" Padding="8"
                                           Text="カテゴリを選択し、ミッションをクリックすると詳細が表示されます。"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- チャットタブ -->
            <TabItem Header="チャット">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: backend selector + data fetch toggle -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="AI バックエンド:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbChatBackend" Width="200" VerticalAlignment="Center" Margin="0,0,16,0"
                                  SelectionChanged="CmbChatBackend_SelectionChanged"/>
                        <CheckBox x:Name="chkFetchScData" Content="スキル使用 (API/DB検索)"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="履歴クリア" Click="ChatClear_Click" Padding="10,4" VerticalAlignment="Center"/>
                        <Button Content="全体コピー" Click="ChatCopyAll_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Content="記憶管理" Click="KnowledgeManage_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- External AI consultation + Verification agent (1 row) -->
                    <WrapPanel x:Name="pnlConsultBackends" Grid.Row="1" Margin="0,0,0,2">
                        <TextBlock Text="📡 外部AI相談:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#666"/>
                        <!-- checkboxes inserted dynamically -->
                        <!-- separator + verify agent appended dynamically -->
                    </WrapPanel>

                    <!-- Chat messages area -->
                    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" ClipToBounds="True">
                        <ScrollViewer x:Name="svChat" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icChatMessages">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,8" CornerRadius="8"
                                                Background="{Binding Background}"
                                                HorizontalAlignment="{Binding Alignment}">
                                            <Border.MaxWidth>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                         Converter="{x:Static local:ChatWidthConverter.Instance}"/>
                                            </Border.MaxWidth>
                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{x:Static local:ChatTemplateSelector.Instance}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Input area -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput" Grid.Column="0" AcceptsReturn="True"
                                 TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Padding="8,6"
                                 PreviewKeyDown="ChatInput_PreviewKeyDown"/>
                        <Button x:Name="btnChatSend" Grid.Column="1" Content="送信" Click="ChatSend_Click"
                                Padding="20,8" Margin="8,0,0,0" FontWeight="Bold"
                                Background="#4A90D9" Foreground="White" FontSize="13"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 設定タブ -->
            <TabItem Header="設定">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="基本設定" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="GamePath:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtSettingsGamePath" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Working Directory:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtWorkDir" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="Output Language:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtOutputLang" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Star Citizen API (チャット用)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="SC API Key:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtScApiKey" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" Foreground="#666" TextWrapping="Wrap"
                                           Text="starcitizen-api.com の API キー。Discord で /api register コマンドで取得できます。"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="UEX 価格送信 (Screen Capture)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="UEX API Key:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtUexApiKey" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" Foreground="#666" TextWrapping="Wrap"
                                           Text="uexcorp.space のデータ送信用 API キー。My Apps ページでアプリを作成して取得できます。PrintScreenキーでゲーム画面をキャプチャし、OCRで価格を読み取ってUEXに送信します。"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="ゲームデータ連携 (Data.p4k)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"
                                           Text="StarBreaker CLI で Data.p4k からゲーム内データ（船・武器・コンポーネント・契約）を抽出しDBに格納します。インデックス構築（約2分半）でパッチ毎のデータをキャッシュし、FTS5 全文検索で日本語・あいまい検索が可能になります。ベクトル検索構築は「AI 設定」のバックエンド（Ollama優先）を使用し約2分15秒（合計約5分）。"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnExtractGameData" Content="インデックス構築"
                                            Click="ExtractGameData_Click" Padding="14,6"
                                            FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                    <Button x:Name="btnBuildVectorIndex" Content="ベクトル検索構築"
                                            Click="BuildVectorIndex_Click" Padding="14,6" Margin="8,0,0,0"
                                            FontWeight="Bold" Background="#9C27B0" Foreground="White"
                                            ToolTip="Ollama/OpenAI/Gemini のエンベディングモデルでセマンティック検索を有効化（バックグラウンド実行）"/>
                                    <Button x:Name="btnFetchWikiMissions" Content="Wiki ミッション取得"
                                            Click="FetchWikiMissions_Click" Padding="14,6" Margin="8,0,0,0"
                                            FontWeight="Bold" Background="#FF9800" Foreground="White"
                                            ToolTip="Star Citizen Wiki API からミッションデータを取得し、既存データと統合"/>
                                    <TextBlock x:Name="txtGameDataStatus" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="#666"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="pbGameData" Height="20" Minimum="0" Maximum="100"/>
                                    <TextBlock x:Name="txtGameDataPct" Grid.Column="1" VerticalAlignment="Center"
                                               Margin="8,0,0,0" MinWidth="50" FontWeight="Bold"/>
                                </Grid>

                                <TextBlock x:Name="txtGameDataDetail" Grid.Row="3" Foreground="#444"
                                           FontFamily="Consolas" FontSize="12"/>

                                <TextBlock x:Name="txtSearchIndexStatus" Grid.Row="4" Margin="0,4,0,0" Foreground="#666"
                                           FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Web チャットサーバー" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="HTTP ポート:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <TextBox x:Name="txtWebPort" Width="60" VerticalAlignment="Center"/>
                                    <TextBlock Text="HTTPS:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox x:Name="txtWebHttpsPort" Width="60" VerticalAlignment="Center"/>
                                    <Button x:Name="btnWebServer" Content="サーバー起動" Click="WebServer_Click"
                                            Padding="14,4" Margin="8,0,0,0" FontWeight="Bold"
                                            Background="#4A90D9" Foreground="White"/>
                                    <CheckBox x:Name="chkWebAutoStart" Content="自動起動" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="VoiceVox URL:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxUrl" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                                <TextBlock Text="VoiceVox 話者ID:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="txtVoiceVoxSpeaker" Grid.Row="2" Grid.Column="1" Width="60"
                                         HorizontalAlignment="Left" Margin="0,4"/>

                                <TextBlock x:Name="txtWebServerInfo" Grid.Row="3" Grid.ColumnSpan="2"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="AI バックエンド状態" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtBackendSummary" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="設定されていません"/>
                                <Button Content="AI 設定を開く" Click="AiSettings_Click" Padding="14,6" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="表示設定" Margin="0,0,0,8" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ミッション詳細フォントサイズ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtMissionFontSize" Width="50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="pt (既定: 14)" VerticalAlignment="Center" Foreground="#666"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="データベース" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="txtDbPath" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="エクスポート (バックアップ)" Click="ExportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4A90D9" Foreground="White" Margin="0,0,8,0"/>
                                    <Button Content="インポート (復元)" Click="ImportDb_Click"
                                            Padding="14,6" FontWeight="Bold" Background="#4CAF50" Foreground="White"/>
                                </StackPanel>
                                <CheckBox x:Name="chkExportMyShips" Content="所持船舶データを含める" IsChecked="True" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtBackupStatus" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="翻訳DBクリア (全翻訳データ削除)" Click="ClearDb_Click"
                                            Padding="14,6" Foreground="#C00"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="設定を保存" Click="SaveSettings_Click" Style="{StaticResource ActionButton}"
                                FontWeight="Bold" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
