<Window x:Class="StarCitizenJapaneseTextCreater.Ship3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3D 表示" Width="1200" Height="860"
        WindowStartupLocation="CenterOwner">
    <!-- 船の 3D 表示の別ウィンドウ (モードレス。［詳細］の［別ウィンドウ］から開く)。中身は Ship3DWeb のビューア。
         上に船の切り替え (［詳細］タブの検索に準じる: 名前の入力欄 (部分一致)・メーカー・種類・サイズで下の候補を絞り込み、選ぶとその船に切り替える)。
         キャッシュの無い船は自動で書き出さず、［読み込み］で取り込む -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="名前" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
            <TextBox x:Name="txtQuery" FontSize="14" TextChanged="TxtQuery_TextChanged" PreviewKeyDown="TxtQuery_PreviewKeyDown"
                     ToolTip="船の名前の一部を入力すると下の候補を絞り込みます。↓ で候補へ、Enter で最初の船に切り替えます"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="メーカー" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbMaker" MinWidth="170" SelectionChanged="CmbFilter_SelectionChanged"/>
            <TextBlock Text="種類" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="cmbKind" MinWidth="170" SelectionChanged="CmbFilter_SelectionChanged"/>
            <TextBlock Text="サイズ" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="cmbSize" MinWidth="80" SelectionChanged="CmbFilter_SelectionChanged"/>
        </StackPanel>

        <ListBox x:Name="lstShips" Grid.Row="2" DisplayMemberPath="Display" SelectionChanged="LstShips_SelectionChanged"/>

        <DockPanel Grid.Row="3" Margin="0,6">
            <TextBlock x:Name="txtShip" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="btnImport" Content="読み込み" Padding="10,2" IsEnabled="False" Click="BtnImport_Click"
                    ToolTip="この船の 3D モデルをゲームデータ (選択中のチャンネルの Data.p4k) から取り込みます。最新のキャッシュがあるとき・書き出し中は使えません"/>
            <TextBlock x:Name="txtShipState" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="4" BorderBrush="#CCC" BorderThickness="1" Background="#1B1E24">
            <Grid>
                <wv2:WebView2 x:Name="web3D" Visibility="Collapsed"/>
                <TextBlock x:Name="txtOverlay" Foreground="#DDD" FontSize="14" TextWrapping="Wrap" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="上の候補から船を選んでください"/>
            </Grid>
        </Border>
    </Grid>
</Window>
