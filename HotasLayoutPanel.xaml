<UserControl x:Class="StarCitizenJapaneseTextCreater.HotasLayoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="修飾キー:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <CheckBox x:Name="chkRCtrl" Content="右Ctrl" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkLShift" Content="左Shift" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <CheckBox x:Name="chkRShift" Content="右Shift" Margin="0,0,20,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                <TextBlock x:Name="txtInfo" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                <Button Content="表示の入れ替え" Click="DisplaySwap_Click" Padding="8,2" Margin="16,0,4,0" VerticalAlignment="Center"
                        ToolTip="アプリ内の 物理スティック↔js 番号 の対応と左右の表示を入れ替えます (ファイルは変わりません)"/>
                <Button Content="js1/js2 の入れ替え" Click="InstanceSwap_Click" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="全ての機能の js1 と js2 の割り当てを入れ替えます (保存時に actionmaps.xml に反映)"/>
                <TextBlock x:Name="txtPressInfo" VerticalAlignment="Center" Foreground="#D32F2F" FontSize="12"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="#FAFAFA" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="色分け:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" FontSize="11"/>
                <Border Background="#42A5F5" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="バインド済み" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#AB47BC" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="長押し" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#F0F0F0" BorderBrush="#B4B4B4" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="未割当" Foreground="#555" FontSize="11"/>
                </Border>
                <TextBlock Text="  |  ボタンをクリックして割り当て編集" VerticalAlignment="Center" Foreground="#888" FontSize="10.5"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- HOTAS L - 左列 (js 番号は Product 名と表示の入れ替えで決まる) -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtHeaderLeft" Text="HOTAS L (js2)" FontWeight="Bold" Padding="8,6" Background="#E3F2FD"/>
                    <Border Grid.Row="1" Background="#FEFEFE" Padding="4" MaxHeight="200" Cursor="Hand"
                            MouseLeftButtonDown="ImageL_Click" ToolTip="クリックで拡大表示">
                        <Image Source="/image/hotas/vkb_scg_L.png" Stretch="Uniform" VerticalAlignment="Top"/>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="4">
                        <StackPanel x:Name="panelLeft" Margin="4"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- HOTAS R - 右列 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtHeaderRight" Text="HOTAS R (js1)" FontWeight="Bold" Padding="8,6" Background="#FFF3E0"/>
                <Border Grid.Row="1" Background="#FEFEFE" Padding="4" MaxHeight="200" Cursor="Hand"
                        MouseLeftButtonDown="ImageR_Click" ToolTip="クリックで拡大表示">
                    <Image Source="/image/hotas/vkb_scg_R.png" Stretch="Uniform" VerticalAlignment="Top"/>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="panelRight" Margin="4"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
